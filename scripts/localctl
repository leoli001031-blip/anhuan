def _sanitize_material_rag_rebuild_evidence(
    payload: object,
) -> dict[str, object] | None:
    if not isinstance(payload, dict):
        return None
    if set(payload) != _MATERIAL_RAG_REBUILD_EVIDENCE_KEYS:
        return None
    checkpoint = payload.get("checkpoint")
    job_status = payload.get("job_status")
    outcome = payload.get("outcome")
    reason_token = payload.get("reason_token")
    if (
        checkpoint not in _MATERIAL_RAG_REBUILD_EVIDENCE_CHECKPOINTS
        or job_status not in _MATERIAL_RAG_INDEX_JOB_STATUSES
        or outcome not in _MATERIAL_RAG_REBUILD_OUTCOMES
        or reason_token not in _MATERIAL_RAG_REBUILD_REASON_TOKENS
    ):
        return None
    sanitized: dict[str, object] = {
        "checkpoint": checkpoint,
        "job_status": job_status,
        "outcome": outcome,
        "reason_token": reason_token,
    }
    for key in sorted(_MATERIAL_RAG_REBUILD_COUNT_KEYS):
        value = payload.get(key)
        if type(value) is not int or value < 0 or value > 999:
            return None
        sanitized[key] = value
    for key in sorted(_MATERIAL_RAG_REBUILD_FLAG_KEYS):
        value = payload.get(key)
        if value not in {0, 1}:
            return None
        sanitized[key] = value
    return sanitized


