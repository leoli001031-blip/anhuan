def _sanitize_material_rag_retrieval_evidence(
    payload: object,
) -> dict[str, object] | None:
    if not isinstance(payload, dict):
        return None
    if set(payload) != _MATERIAL_RAG_RETRIEVAL_EVIDENCE_KEYS:
        return None
    checkpoint = payload.get("checkpoint")
    if checkpoint not in _MATERIAL_RAG_RETRIEVAL_EVIDENCE_CHECKPOINTS:
        return None
    sanitized: dict[str, object] = {"checkpoint": checkpoint}
    for key in sorted(_MATERIAL_RAG_RETRIEVAL_COUNT_KEYS):
        value = payload.get(key)
        if type(value) is not int or value < 0 or value > 999:
            return None
        sanitized[key] = value
    for key in sorted(_MATERIAL_RAG_RETRIEVAL_REFUSAL_TOKEN_KEYS):
        value = payload.get(key)
        if value not in _MATERIAL_RAG_RETRIEVAL_REFUSAL_TOKENS:
            return None
        sanitized[key] = value
    return sanitized


