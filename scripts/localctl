_MATERIAL_RAG_EGRESS_EVIDENCE_PREFIX = "LOCAL_MATERIAL_RAG_EGRESS_EVIDENCE "
_MATERIAL_RAG_EGRESS_EVIDENCE_DEGRADED = "LOCAL_MATERIAL_RAG_EGRESS_EVIDENCE_DEGRADED"
_MATERIAL_RAG_EGRESS_EVIDENCE_MAX_BYTES = 1024
_MATERIAL_RAG_EGRESS_COUNTER_MAX = 1_000_000_000
_MATERIAL_RAG_EGRESS_EVIDENCE_KEYS = frozenset(
    {
        "audit_status",
        "authorized_embedding_request_count",
        "forwarded_embedding_request_count",
        "rejected_json_count",
        "rejected_model_count",
        "rejected_non_text_input_count",
        "rejected_path_count",
        "rejected_request_count",
        "rejected_unauthorized_text_count",
        "upstream_2xx_count",
        "upstream_4xx_count",
        "upstream_5xx_count",
    }
)
_MATERIAL_RAG_EGRESS_AUDIT_STATUSES = frozenset(
    {"INVALID", "MISSING", "READY", "UNAVAILABLE"}
)


def _sanitize_material_rag_egress_evidence(
    payload: object,
) -> dict[str, object] | None:
    if not isinstance(payload, dict):
        return None
    if set(payload) != _MATERIAL_RAG_EGRESS_EVIDENCE_KEYS:
        return None
    status = payload.get("audit_status")
    if status not in _MATERIAL_RAG_EGRESS_AUDIT_STATUSES:
        return None
    sanitized: dict[str, object] = {"audit_status": status}
    for key in _MATERIAL_RAG_EGRESS_EVIDENCE_KEYS:
        if key == "audit_status":
            continue
        raw = payload.get(key)
        if type(raw) is not int or raw < 0 or raw > _MATERIAL_RAG_EGRESS_COUNTER_MAX:
            return None
        sanitized[key] = raw
    return sanitized


def _emit_material_rag_egress_evidence(
    stdout: str, stderr: str, reason: str
) -> None:
    if reason != "LOCAL_MATERIAL_RAG_INDEX_FAILED":
        return
    evidence_lines = [
        line
        for line in _material_rag_captured_lines(stdout, stderr)
        if line.startswith(_MATERIAL_RAG_EGRESS_EVIDENCE_PREFIX)
    ]
    if any(
        len(line.encode("utf-8")) > _MATERIAL_RAG_EGRESS_EVIDENCE_MAX_BYTES
        for line in evidence_lines
    ):
        print(
            _MATERIAL_RAG_EGRESS_EVIDENCE_DEGRADED + " MALFORMED",
            file=sys.stderr,
            flush=True,
        )
        return
    if len(evidence_lines) > 1:
        print(
            _MATERIAL_RAG_EGRESS_EVIDENCE_DEGRADED + " DUPLICATE",
            file=sys.stderr,
            flush=True,
        )
        return
    if len(evidence_lines) == 0:
        print(
            _MATERIAL_RAG_EGRESS_EVIDENCE_DEGRADED + " MISSING",
            file=sys.stderr,
            flush=True,
        )
        return
    try:
        payload = json.loads(
            evidence_lines[0][len(_MATERIAL_RAG_EGRESS_EVIDENCE_PREFIX) :]
        )
    except json.JSONDecodeError:
        payload = None
    sanitized = _sanitize_material_rag_egress_evidence(payload)
    if sanitized is None:
        print(
            _MATERIAL_RAG_EGRESS_EVIDENCE_DEGRADED + " MALFORMED",
            file=sys.stderr,
            flush=True,
        )
        return
    print(
        _MATERIAL_RAG_EGRESS_EVIDENCE_PREFIX
        + json.dumps(
            sanitized,
            ensure_ascii=True,
            separators=(",", ":"),
            sort_keys=True,
        ),
        file=sys.stderr,
        flush=True,
    )


