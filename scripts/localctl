def _sanitize_material_rag_internal_evidence(
    payload: object,
) -> dict[str, object] | None:
    if not isinstance(payload, dict):
        return None
    if set(payload) != _MATERIAL_RAG_INTERNAL_EVIDENCE_KEYS:
        return None
    error_class = payload.get("error_class")
    operation = payload.get("operation")
    phase = payload.get("phase")
    primary_preserved = payload.get("primary_preserved")
    sqlstate = payload.get("sqlstate")
    db_token = payload.get("db_token")
    if (
        error_class not in _MATERIAL_RAG_INTERNAL_EVIDENCE_ERROR_CLASSES
        or operation not in _MATERIAL_RAG_INTERNAL_EVIDENCE_OPERATIONS
        or phase not in _MATERIAL_RAG_INTERNAL_EVIDENCE_PHASES
        or type(primary_preserved) is not bool
        or not isinstance(sqlstate, str)
        or not isinstance(db_token, str)
        or (
            sqlstate != "NONE"
            and _MATERIAL_RAG_INTERNAL_EVIDENCE_SQLSTATE_RE.fullmatch(sqlstate)
            is None
        )
        or (db_token != "NONE" and db_token not in _MATERIAL_RAG_INTERNAL_EVIDENCE_DB_TOKENS)
    ):
        return None
    return {
        "db_token": db_token,
        "error_class": error_class,
        "operation": operation,
        "phase": phase,
        "primary_preserved": primary_preserved,
        "sqlstate": sqlstate,
    }


def _emit_material_rag_internal_evidence(
    stdout: str, stderr: str, reason: str
) -> None:
    if reason != "LOCAL_MATERIAL_RAG_INTERNAL_ERROR":
        return
    evidence_lines = [
        line
        for line in _material_rag_captured_lines(stdout, stderr)
        if line.startswith(_MATERIAL_RAG_INTERNAL_EVIDENCE_PREFIX)
    ]
    if any(
        len(line.encode("utf-8")) > _MATERIAL_RAG_INTERNAL_EVIDENCE_MAX_BYTES
        for line in evidence_lines
    ):
        print(
            _MATERIAL_RAG_INTERNAL_EVIDENCE_DEGRADED + " MALFORMED",
            file=sys.stderr,
            flush=True,
        )
        return
    if len(evidence_lines) > 1:
        print(
            _MATERIAL_RAG_INTERNAL_EVIDENCE_DEGRADED + " DUPLICATE",
            file=sys.stderr,
            flush=True,
        )
        return
    if len(evidence_lines) == 0:
        print(
            _MATERIAL_RAG_INTERNAL_EVIDENCE_DEGRADED + " MISSING",
            file=sys.stderr,
            flush=True,
        )
        return
    try:
        payload = json.loads(
            evidence_lines[0][len(_MATERIAL_RAG_INTERNAL_EVIDENCE_PREFIX) :]
        )
    except json.JSONDecodeError:
        payload = None
    sanitized = _sanitize_material_rag_internal_evidence(payload)
    if sanitized is None:
        print(
            _MATERIAL_RAG_INTERNAL_EVIDENCE_DEGRADED + " MALFORMED",
            file=sys.stderr,
            flush=True,
        )
        return
    print(
        _MATERIAL_RAG_INTERNAL_EVIDENCE_PREFIX
        + json.dumps(
            sanitized,
            ensure_ascii=True,
            separators=(",", ":"),
            sort_keys=True,
        ),
        file=sys.stderr,
        flush=True,
    )


