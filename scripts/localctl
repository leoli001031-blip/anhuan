    ),
)
_MATERIAL_RAG_IMAGE_SOURCE_ROOT_RE = re.compile(r"\A[0-9a-f]{64}\Z")
_MATERIAL_RAG_IMAGE_SOURCE_EVIDENCE_PREFIX = (
    "LOCAL_MATERIAL_RAG_IMAGE_SOURCE_EVIDENCE "
)


def _material_rag_build_ascii(value: object) -> str:
    if not isinstance(value, str):
        return ""
    return value.encode("ascii", "ignore").decode("ascii").lower()


def _classify_material_rag_build_evidence(
    stdout: str, stderr: str, exit_code: object
) -> dict[str, object]:
    payload: dict[str, object] = {
        "detail_class": "UNKNOWN",
        "exit_class": "UNKNOWN",
        "exit_code": 0,
        "phase": "UNKNOWN",
    }
    if type(exit_code) is int and 0 <= exit_code <= 255:
        payload["exit_code"] = exit_code
    text = (
        _material_rag_build_ascii(stdout)
        + "\n"
        + _material_rag_build_ascii(stderr)
    )
    dependency = (
        "could not install packages" in text
        or "pip install" in text
        or "downloading " in text
        or "requirement" in text
    )
    if "do not match the hashes" in text or "hash mismatch" in text:
        payload["exit_class"] = "HASH"
        payload["detail_class"] = "HASH"
        payload["phase"] = "DEPENDENCY_INSTALL" if dependency else "OTHER"
        return payload
    if "no space left on device" in text or "enospc" in text:
        payload["exit_class"] = "NO_SPACE"
        payload["detail_class"] = "NO_SPACE"
        payload["phase"] = "DEPENDENCY_INSTALL" if dependency else "OTHER"
        return payload
    if (
        "read timed out" in text
        or "readtimeout" in text
        or "timed out" in text
    ):
        payload["exit_class"] = "TIMEOUT"
        payload["detail_class"] = "NETWORK_TIMEOUT"
        payload["phase"] = "DEPENDENCY_INSTALL" if dependency else "OTHER"
        return payload
    tls_eof = (
        "ssleoferror" in text
        or "unexpected_eof_while_reading" in text
        or "eof occurred in violation of protocol" in text
    )
    if tls_eof or "sslerror" in text:
        payload["exit_class"] = "TLS"
        payload["detail_class"] = "TLS_EOF" if tls_eof else "TLS_OTHER"
        payload["phase"] = "DEPENDENCY_INSTALL" if dependency else "OTHER"
        return payload
    if (
        "getaddrinfo" in text
        or "name or service not known" in text
        or "temporary failure in name resolution" in text
        or "nodename nor servname" in text
    ):
        payload["exit_class"] = "DNS"
        payload["detail_class"] = "DNS"
        payload["phase"] = "DEPENDENCY_INSTALL" if dependency else "OTHER"
        return payload
    if dependency:
        payload["exit_class"] = "OTHER"
        payload["detail_class"] = "OTHER"
        payload["phase"] = "DEPENDENCY_INSTALL"
        return payload
    if type(exit_code) is int and exit_code != 0:
        payload["exit_class"] = "OTHER"
        payload["detail_class"] = "OTHER"
        payload["phase"] = "OTHER"
    return payload


def _emit_material_rag_build_evidence(
    stdout: str, stderr: str, exit_code: object
) -> None:
    payload = _classify_material_rag_build_evidence(stdout, stderr, exit_code)
    if (
        set(payload) != _MATERIAL_RAG_BUILD_EVIDENCE_KEYS
        or payload["exit_class"] not in _MATERIAL_RAG_BUILD_EXIT_CLASSES
        or payload["phase"] not in _MATERIAL_RAG_BUILD_PHASES
        or payload["detail_class"] not in _MATERIAL_RAG_BUILD_DETAIL_CLASSES
        or type(payload["exit_code"]) is not int
        or not 0 <= int(payload["exit_code"]) <= 255
    ):
        payload = {
            "detail_class": "UNKNOWN",
            "exit_class": "UNKNOWN",
            "exit_code": 0,
            "phase": "UNKNOWN",
        }
    line = _MATERIAL_RAG_BUILD_EVIDENCE_PREFIX + json.dumps(
        payload,
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    )
    if len(line.encode("utf-8")) > 1024:
        return
    print(line, file=sys.stderr, flush=True)


def _material_rag_compose_stage(
    state: dict[str, object],
    env_file: Path,
    *arguments: str,
    timeout: int,
    failure_reason: str,
    allowed_reasons: frozenset[str] = frozenset(),
) -> subprocess.CompletedProcess[str]:
    """Run one material-RAG stage without exposing captured command output."""
    if not re.fullmatch(r"LOCAL_MATERIAL_RAG_[A-Z0-9_]{1,64}", failure_reason):
        raise LocalError("LOCAL_MATERIAL_RAG_STAGE_REASON_INVALID")
    try:
        result = _material_rag_compose(
            state,
            env_file,
            *arguments,
            capture=True,
            timeout=timeout,
            check=False,
        )
    except LocalError:
        if failure_reason == "LOCAL_MATERIAL_RAG_BUILD_FAILED":
            _emit_material_rag_build_evidence("", "", 0)
        if failure_reason in MATERIAL_RAG_OOM_EVIDENCE_STAGES:
            _raise_material_rag_oom_if_observed(state, failure_reason)
        raise LocalError(failure_reason) from None
    if result.returncode != 0:
        if failure_reason == "LOCAL_MATERIAL_RAG_BUILD_FAILED":
            _emit_material_rag_build_evidence(
                result.stdout, result.stderr, result.returncode
            )
            raise LocalError(failure_reason)
        if failure_reason in MATERIAL_RAG_OOM_EVIDENCE_STAGES:
            _raise_material_rag_oom_if_observed(state, failure_reason)
        if allowed_reasons == MATERIAL_RAG_PROVIDER_FAILURE_REASONS:
            reason = _emit_material_rag_provider_diagnostics(
                result.stdout, result.stderr, fallback_reason=failure_reason
            )
            raise LocalError(reason)
        reason = _contract_failure_reason(result.stderr, allowed_reasons)
        raise LocalError(reason or failure_reason)
    return result


def _material_rag_container_evidence(
    state: dict[str, object], *, oom_only: bool
) -> tuple[dict[str, object], ...]:
    try:
        project, project_id, _database, _probe = _material_rag_identity(state)
        parent_id = str(state["project_id"])
        container_ids = _resource_ids(
            "ps", project, material_rag=True, timeout=10
        )
    except (KeyError, LocalError):
        return ()
    evidence_by_service: dict[str, dict[str, object]] = {}
    for container_id in container_ids:
        try:
            inspected = _run(
                [_docker(), "inspect", container_id],
                capture=True,
                check=False,
                material_rag=True,
                timeout=10,
            )
        except LocalError:
            continue
        if inspected.returncode != 0:
            continue
        try:
            payload = json.loads(inspected.stdout)[0]
            labels = payload["Config"]["Labels"]
            container_state = payload["State"]
            service = labels["com.docker.compose.service"]
            oom_killed = container_state["OOMKilled"]
            exit_code = container_state["ExitCode"]
            restart_count = payload["RestartCount"]
            status = container_state["Status"]
            health_state = container_state.get("Health")
            health = (
                "none"
                if health_state is None
                else health_state.get("Status", "unknown")
            )
        except (
            AttributeError,
            IndexError,
            KeyError,
            TypeError,
            json.JSONDecodeError,
        ):
            continue
        if (
            labels.get("com.docker.compose.project") != project
            or labels.get("io.anhuan.scope") != MATERIAL_RAG_SCOPE
            or labels.get("io.anhuan.project-id") != project_id
            or labels.get("io.anhuan.parent-project-id") != parent_id
            or not isinstance(service, str)
            or service not in MATERIAL_RAG_OOM_EVIDENCE_SERVICES
            or oom_killed not in {True, False}
            or (oom_only and oom_killed is not True)
            or (
                oom_only
                and status == "running"
                and health == "healthy"
                and exit_code == 0
            )
            or type(exit_code) is not int
            or not 0 <= exit_code <= 255
            or type(restart_count) is not int
            or not 0 <= restart_count <= 1_000_000
            or not isinstance(status, str)
            or not isinstance(health, str)
        ):
            continue
        if status not in MATERIAL_RAG_OOM_EVIDENCE_STATUSES:
            status = "unknown"
        if health not in MATERIAL_RAG_OOM_EVIDENCE_HEALTH:
            health = "unknown"
        evidence_by_service[service] = {
            "exit_code": exit_code,
            "health": health,
            "oom_killed": oom_killed,
            "restart_count": restart_count,
            "service": service,
            "status": status,
        }
    return tuple(
        sorted(
            evidence_by_service.values(),
            key=lambda item: (
                str(item["service"]),
                int(item["restart_count"]),
                int(item["exit_code"]),
            ),
        )
    )


def _material_rag_stack_oom_evidence(
    state: dict[str, object], failure_stage: str
) -> tuple[dict[str, object], ...]:
    if failure_stage not in MATERIAL_RAG_OOM_EVIDENCE_STAGES:
        return ()
    return _material_rag_container_evidence(state, oom_only=True)


def _emit_material_rag_failure_evidence(
    state: dict[str, object], failure_stage: str
) -> None:
    if not re.fullmatch(r"LOCAL_MATERIAL_RAG_[A-Z0-9_]{1,64}", failure_stage):
        failure_stage = "LOCAL_MATERIAL_RAG_INTERNAL_ERROR"
    try:
        containers = _material_rag_container_evidence(state, oom_only=False)
    except (KeyError, LocalError, TypeError, ValueError):
        containers = ()
    print(
        "LOCAL_MATERIAL_RAG_FAILURE_EVIDENCE "
        + json.dumps(
            {"containers": containers, "failure_stage": failure_stage},
            ensure_ascii=True,
            separators=(",", ":"),
            sort_keys=True,
        ),
        file=sys.stderr,
        flush=True,
    )


_MATERIAL_RAG_PREVIEW_EVIDENCE_PREFIX = "LOCAL_MATERIAL_RAG_P3_PREVIEW_EVIDENCE "
_MATERIAL_RAG_PREVIEW_EVIDENCE_LINES = frozenset({1, 2, 19, 21})
_MATERIAL_RAG_PREVIEW_EVIDENCE_STATUSES = frozenset(
    {"blocked", "failed", "generating", "queued", "ready"}
)
_MATERIAL_RAG_PREVIEW_EVIDENCE_REASON_RE = re.compile(
    r"(?:P3_[A-Z0-9_]{1,64}|MISSING|NOT_REACHED|OTHER)\Z"
)


def _material_rag_captured_lines(stdout: str, stderr: str) -> tuple[str, ...]:
    lines: list[str] = []
    for payload in (stdout, stderr):
        if not isinstance(payload, str):
            continue
        lines.extend(payload.splitlines())
    return tuple(lines)


def _emit_material_rag_preview_evidence(stdout: str, stderr: str) -> None:
    matches = [
        line
        for line in _material_rag_captured_lines(stdout, stderr)
        if line.startswith(_MATERIAL_RAG_PREVIEW_EVIDENCE_PREFIX)
        and len(line.encode("utf-8")) <= 512
    ]
    unique = list(dict.fromkeys(matches))
    if len(unique) != 1:
        return
    try:
        payload = json.loads(unique[0][len(_MATERIAL_RAG_PREVIEW_EVIDENCE_PREFIX) :])
    except json.JSONDecodeError:
        return
    if not isinstance(payload, dict):
        return
    fixture_line = payload.get("fixture_line")
    if fixture_line not in _MATERIAL_RAG_PREVIEW_EVIDENCE_LINES:
        fixture_line = 0
    preview_status = payload.get("preview_status")
    if preview_status not in _MATERIAL_RAG_PREVIEW_EVIDENCE_STATUSES:
        preview_status = "unknown"
    error_reason = payload.get("error_reason")
    if (
        not isinstance(error_reason, str)
        or _MATERIAL_RAG_PREVIEW_EVIDENCE_REASON_RE.fullmatch(error_reason) is None
    ):
        error_reason = "OTHER"
    print(
        _MATERIAL_RAG_PREVIEW_EVIDENCE_PREFIX
        + json.dumps(
            {
                "error_reason": error_reason,
                "fixture_line": fixture_line,
                "preview_status": preview_status,
            },
            ensure_ascii=True,
            separators=(",", ":"),
            sort_keys=True,
        ),
        file=sys.stderr,
        flush=True,
    )


def _contract_verifier_reason(stdout: str, stderr: str) -> str | None:
    matches: list[str] = []
    seen: set[str] = set()
    for line in _material_rag_captured_lines(stdout, stderr):
        if line not in MATERIAL_RAG_VERIFIER_FAILURE_REASONS or line in seen:
            continue
        seen.add(line)
        matches.append(line)
    if len(matches) != 1:
        return None
    return matches[0]


def _emit_material_rag_verifier_diagnostics(
    stdout: str, stderr: str, *, fallback_reason: str
) -> str:
    _emit_material_rag_preview_evidence(stdout, stderr)
    reason = _contract_verifier_reason(stdout, stderr) or fallback_reason
    if not re.fullmatch(r"LOCAL_MATERIAL_RAG_[A-Z0-9_]{1,64}", reason):
        reason = "LOCAL_COMMAND_FAILED"
    print(
        "LOCAL_MATERIAL_RAG_VERIFIER_REASON " + reason,
        file=sys.stderr,
        flush=True,
    )
    _emit_material_rag_scanner_evidence(stdout, stderr, reason)
    _emit_material_rag_internal_evidence(stdout, stderr, reason)
    _emit_material_rag_index_evidence(stdout, stderr, reason)
    _emit_material_rag_egress_evidence(stdout, stderr, reason)
    _emit_material_rag_retrieval_evidence(stdout, stderr, reason)
    _emit_material_rag_rebuild_evidence(stdout, stderr, reason)
    return reason


def _emit_material_rag_unreachable_verifier_diagnostics(
    state: dict[str, object] | None = None,
) -> None:
    print(
        _MATERIAL_RAG_PREVIEW_EVIDENCE_PREFIX
        + json.dumps(
            {
                "error_reason": "NOT_REACHED",
                "fixture_line": 0,
                "preview_status": "unknown",
            },
            ensure_ascii=True,
            separators=(",", ":"),
            sort_keys=True,
        ),
        file=sys.stderr,
        flush=True,
    )
    print(
        "LOCAL_MATERIAL_RAG_VERIFIER_REASON "
        "LOCAL_MATERIAL_RAG_VERIFIER_NOT_REACHED",
        file=sys.stderr,
        flush=True,
    )
    _emit_material_rag_scanner_reach_evidence(state)


_MATERIAL_RAG_SCANNER_EVIDENCE_PREFIX = "LOCAL_MATERIAL_RAG_SCANNER_EVIDENCE "
_MATERIAL_RAG_SCANNER_EVIDENCE_DEGRADED = (
    "LOCAL_MATERIAL_RAG_SCANNER_EVIDENCE_DEGRADED"
)
_MATERIAL_RAG_SCANNER_EVIDENCE_MAX_BYTES = 1024
_MATERIAL_RAG_SCANNER_EVIDENCE_MAX_ATTEMPTS = 64
_MATERIAL_RAG_SCANNER_EVIDENCE_KEYS = frozenset(
    {
        "attempt_count",
        "operation",
        "phase",
        "response_class",
        "scan_code",
    }
)
_MATERIAL_RAG_SCANNER_EVIDENCE_OPERATIONS = frozenset({"INSTREAM", "VERSION"})
_MATERIAL_RAG_SCANNER_EVIDENCE_PHASES = frozenset(
    {"CONNECT", "PARSE", "RECV", "RESOLVE", "SEND"}
)
_MATERIAL_RAG_SCANNER_EVIDENCE_RESPONSE_CLASSES = frozenset(
    {"EMPTY", "ENGINE_ERROR", "FORMAT_MISMATCH", "NOT_APPLICABLE", "OVERSIZE"}
)
_MATERIAL_RAG_SCANNER_EVIDENCE_CODE_TO_REASON = {
    "P3_SCAN_ENGINE_ERROR": "LOCAL_MATERIAL_RAG_P3_SCAN_ENGINE_FAILED",
    "P3_SCAN_PROTOCOL_ERROR": "LOCAL_MATERIAL_RAG_P3_SCAN_PROTOCOL_FAILED",
    "P3_SCANNER_CONNECT_PIPE": "LOCAL_MATERIAL_RAG_P3_SCAN_CONNECT_PIPE_FAILED",
    "P3_SCANNER_CONNECT_REFUSED": "LOCAL_MATERIAL_RAG_P3_SCAN_CONNECT_REFUSED_FAILED",
    "P3_SCANNER_CONNECT_RESET": "LOCAL_MATERIAL_RAG_P3_SCAN_CONNECT_RESET_FAILED",
    "P3_SCANNER_DNS_FAILED": "LOCAL_MATERIAL_RAG_P3_SCAN_DNS_FAILED",
    "P3_SCANNER_STREAM_PIPE": "LOCAL_MATERIAL_RAG_P3_SCAN_STREAM_PIPE_FAILED",
    "P3_SCANNER_STREAM_REFUSED": "LOCAL_MATERIAL_RAG_P3_SCAN_STREAM_REFUSED_FAILED",
    "P3_SCANNER_STREAM_RESET": "LOCAL_MATERIAL_RAG_P3_SCAN_STREAM_RESET_FAILED",
    "P3_SCANNER_TARGET_INVALID": "LOCAL_MATERIAL_RAG_P3_SCAN_TARGET_FAILED",
    "P3_SCANNER_TIMEOUT": "LOCAL_MATERIAL_RAG_P3_SCAN_TIMEOUT_FAILED",
    "P3_SCANNER_UNAVAILABLE": "LOCAL_MATERIAL_RAG_P3_SCAN_CONNECT_FAILED",
    "P3_SCANNER_VERSION_PIPE": "LOCAL_MATERIAL_RAG_P3_SCAN_VERSION_PIPE_FAILED",
    "P3_SCANNER_VERSION_REFUSED": "LOCAL_MATERIAL_RAG_P3_SCAN_VERSION_REFUSED_FAILED",
    "P3_SCANNER_VERSION_RESET": "LOCAL_MATERIAL_RAG_P3_SCAN_VERSION_RESET_FAILED",
}
_MATERIAL_RAG_SCANNER_EVIDENCE_SCAN_CODES = frozenset(
    _MATERIAL_RAG_SCANNER_EVIDENCE_CODE_TO_REASON
)
_MATERIAL_RAG_SCANNER_EVIDENCE_REASONS = frozenset(
    _MATERIAL_RAG_SCANNER_EVIDENCE_CODE_TO_REASON.values()
)
_MATERIAL_RAG_SCANNER_EVIDENCE_REASON_TO_CODE = {
    reason: code
    for code, reason in _MATERIAL_RAG_SCANNER_EVIDENCE_CODE_TO_REASON.items()
}
_MATERIAL_RAG_VERIFIER_STARTED_STATUSES = frozenset(
    {"dead", "exited", "paused", "removing", "restarting", "running"}
)


def _sanitize_material_rag_scanner_evidence(
    payload: object,
) -> dict[str, object] | None:
    if not isinstance(payload, dict):
        return None
    if set(payload) != _MATERIAL_RAG_SCANNER_EVIDENCE_KEYS:
        return None
    attempt_count = payload.get("attempt_count")
    operation = payload.get("operation")
    phase = payload.get("phase")
    response_class = payload.get("response_class")
    scan_code = payload.get("scan_code")
    if (
        type(attempt_count) is not int
        or not 1 <= attempt_count <= _MATERIAL_RAG_SCANNER_EVIDENCE_MAX_ATTEMPTS
        or operation not in _MATERIAL_RAG_SCANNER_EVIDENCE_OPERATIONS
        or phase not in _MATERIAL_RAG_SCANNER_EVIDENCE_PHASES
        or response_class not in _MATERIAL_RAG_SCANNER_EVIDENCE_RESPONSE_CLASSES
        or scan_code not in _MATERIAL_RAG_SCANNER_EVIDENCE_SCAN_CODES
    ):
        return None
    return {
        "attempt_count": attempt_count,
        "operation": operation,
        "phase": phase,
        "response_class": response_class,
        "scan_code": scan_code,
    }


def _material_rag_exact_service_container_ids(
    state: dict[str, object], service: str
) -> tuple[str, ...] | None:
    try:
        project, _project_id, _database, _probe = _material_rag_identity(state)
        result = _run(
            [
                _docker(),
                "ps",
                "-a",
                "-q",
                "--no-trunc",
                "--filter",
                f"label=com.docker.compose.project={project}",
                "--filter",
                f"label=com.docker.compose.service={service}",
            ],
            capture=True,
            check=False,
            material_rag=True,
            timeout=10,
        )
    except (KeyError, LocalError, TypeError, ValueError):
        return None
    if result.returncode != 0:
        return None
    return tuple(line for line in result.stdout.splitlines() if line)


def _material_rag_inspect_labeled_container(
    state: dict[str, object], container_id: str
) -> tuple[str, str] | None:
    try:
        project, project_id, _database, _probe = _material_rag_identity(state)
        parent_id = str(state["project_id"])
        inspected = _run(
            [_docker(), "inspect", container_id],
            capture=True,
            check=False,
            material_rag=True,
            timeout=10,
        )
    except (KeyError, LocalError, TypeError, ValueError):
        return None
    if inspected.returncode != 0:
        return None
    try:
        payload = json.loads(inspected.stdout)[0]
        labels = payload["Config"]["Labels"]
        service = labels["com.docker.compose.service"]
        status = payload["State"]["Status"]
    except (
        AttributeError,
        IndexError,
        KeyError,
        TypeError,
        json.JSONDecodeError,
    ):
        return None
    if (
        not isinstance(service, str)
        or not isinstance(status, str)
        or labels.get("com.docker.compose.project") != project
        or labels.get("io.anhuan.scope") != MATERIAL_RAG_SCOPE
        or labels.get("io.anhuan.project-id") != project_id
        or labels.get("io.anhuan.parent-project-id") != parent_id
    ):
        return None
    return service, status


def _material_rag_complete_container_snapshot(
    state: dict[str, object],
) -> tuple[dict[str, str], ...] | None:
    try:
        project, _project_id, _database, _probe = _material_rag_identity(state)
        container_ids = _resource_ids(
            "ps", project, material_rag=True, timeout=10
        )
    except (KeyError, LocalError, TypeError, ValueError):
        return None
    items: list[dict[str, str]] = []
    for container_id in container_ids:
        labeled = _material_rag_inspect_labeled_container(state, container_id)
        if labeled is None:
            return None
        service, status = labeled
        items.append({"service": service, "status": status})
    return tuple(items)


def _material_rag_reach_from_status(status: object) -> str:
    if status in _MATERIAL_RAG_VERIFIER_STARTED_STATUSES:
        return "reached"
    if status == "created":
        return "not_reached"
    return "unknown"


def _material_rag_verifier_reach(
    state: dict[str, object] | None,
) -> str:
    if not isinstance(state, dict):
        return "unknown"
    exact_ids = _material_rag_exact_service_container_ids(
        state, "material-rag-verifier"
    )
    if exact_ids is not None:
        if len(exact_ids) == 0:
            return "not_reached"
        if len(exact_ids) != 1:
            return "unknown"
        labeled = _material_rag_inspect_labeled_container(state, exact_ids[0])
        if labeled is None or labeled[0] != "material-rag-verifier":
            return "unknown"
        return _material_rag_reach_from_status(labeled[1])
    snapshot = _material_rag_complete_container_snapshot(state)
    if snapshot is None:
        return "unknown"
    verifier = next(
        (
            item
            for item in snapshot
            if item.get("service") == "material-rag-verifier"
        ),
        None,
    )
    if verifier is None:
        return "not_reached"
    return _material_rag_reach_from_status(verifier.get("status"))


def _emit_material_rag_scanner_reach_evidence(
    state: dict[str, object] | None,
) -> None:
    reach = _material_rag_verifier_reach(state)
    if reach == "not_reached":
        print(
            "LOCAL_MATERIAL_RAG_SCANNER_EVIDENCE_NOT_REACHED",
            file=sys.stderr,
            flush=True,
        )
        return
    print(
        _MATERIAL_RAG_SCANNER_EVIDENCE_DEGRADED + " MISSING",
        file=sys.stderr,
        flush=True,
    )


def _emit_material_rag_scanner_evidence(
    stdout: str, stderr: str, reason: str
) -> None:
    if reason not in _MATERIAL_RAG_SCANNER_EVIDENCE_REASONS:
        return
    evidence_lines = [
        line
        for line in _material_rag_captured_lines(stdout, stderr)
        if line.startswith(_MATERIAL_RAG_SCANNER_EVIDENCE_PREFIX)
        and len(line.encode("utf-8")) <= _MATERIAL_RAG_SCANNER_EVIDENCE_MAX_BYTES
    ]
    if len(evidence_lines) > 1:
        print(
            _MATERIAL_RAG_SCANNER_EVIDENCE_DEGRADED + " DUPLICATE",
            file=sys.stderr,
            flush=True,
        )
        return
    if len(evidence_lines) == 0:
        print(
            _MATERIAL_RAG_SCANNER_EVIDENCE_DEGRADED + " MISSING",
            file=sys.stderr,
            flush=True,
        )
        return
    try:
        payload = json.loads(
            evidence_lines[0][len(_MATERIAL_RAG_SCANNER_EVIDENCE_PREFIX) :]
        )
    except json.JSONDecodeError:
        payload = None
    sanitized = _sanitize_material_rag_scanner_evidence(payload)
    if (
        sanitized is None
        or _MATERIAL_RAG_SCANNER_EVIDENCE_REASON_TO_CODE.get(reason)
        != sanitized["scan_code"]
    ):
        print(
            _MATERIAL_RAG_SCANNER_EVIDENCE_DEGRADED + " MALFORMED",
            file=sys.stderr,
            flush=True,
        )
        return
    print(
        _MATERIAL_RAG_SCANNER_EVIDENCE_PREFIX
        + json.dumps(
            sanitized,
            ensure_ascii=True,
            separators=(",", ":"),
            sort_keys=True,
        ),
        file=sys.stderr,
        flush=True,
    )


