def _sanitize_material_rag_index_evidence(
    payload: object,
) -> dict[str, object] | None:
    if not isinstance(payload, dict):
        return None
    if set(payload) != _MATERIAL_RAG_INDEX_EVIDENCE_KEYS:
        return None
    checkpoint = payload.get("checkpoint")
    job_status = payload.get("job_status")
    operation = payload.get("operation")
    phase = payload.get("phase")
    reason_token = payload.get("reason_token")
    outcome = payload.get("outcome")
    lease_source = payload.get("lease_source")
    lease_present = payload.get("lease_present")
    lease_live = payload.get("lease_live")
    token_match = payload.get("token_match")
    finish_sqlstate = payload.get("finish_sqlstate")
    if (
        checkpoint not in _MATERIAL_RAG_INDEX_EVIDENCE_CHECKPOINTS
        or job_status not in _MATERIAL_RAG_INDEX_JOB_STATUSES
        or operation not in _MATERIAL_RAG_INTERNAL_EVIDENCE_OPERATIONS
        or phase not in _MATERIAL_RAG_INTERNAL_EVIDENCE_PHASES
        or reason_token not in _MATERIAL_RAG_INDEX_REASON_TOKENS
        or outcome not in _MATERIAL_RAG_INDEX_OUTCOMES
        or lease_source not in _MATERIAL_RAG_INDEX_LEASE_SOURCES
        or type(lease_present) is not bool
        or type(lease_live) is not bool
        or type(token_match) is not bool
        or not (
            finish_sqlstate == "NONE"
            or (
                isinstance(finish_sqlstate, str)
                and _MATERIAL_RAG_INDEX_SQLSTATE_RE.fullmatch(finish_sqlstate)
            )
        )
    ):
        return None
    return {
        "checkpoint": checkpoint,
        "finish_sqlstate": finish_sqlstate,
        "job_status": job_status,
        "lease_live": lease_live,
        "lease_present": lease_present,
        "lease_source": lease_source,
        "operation": operation,
        "outcome": outcome,
        "phase": phase,
        "reason_token": reason_token,
        "token_match": token_match,
    }


