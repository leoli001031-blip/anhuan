def _initialize_material_rag_control() -> dict[str, object]:
    _directory(MATERIAL_RAG_CONTROL_DIR)
    for directory in (
        MATERIAL_RAG_CONTROL_HOME_DIR,
        MATERIAL_RAG_CONTROL_TMP_DIR,
    ):
        _directory(directory)
    expected = _material_rag_control_state()
    data = (
        json.dumps(expected, sort_keys=True, separators=(",", ":")) + "\n"
    ).encode("ascii")
    if MATERIAL_RAG_CONTROL_STATE_FILE.exists():
        _secure_file(MATERIAL_RAG_CONTROL_STATE_FILE, maximum=4096)
        try:
            observed_data = MATERIAL_RAG_CONTROL_STATE_FILE.read_bytes()
            observed = json.loads(observed_data.decode("ascii"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_STATE_INVALID") from None
        if observed != expected or observed_data != data:
            raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_STATE_INVALID")
    else:
        _exclusive_write(MATERIAL_RAG_CONTROL_STATE_FILE, data)
    _write_material_rag_docker_config()
    return expected


def _remove_material_rag_control() -> None:
    expected_name = (
        f"anhuan-material-rag-control-{MATERIAL_RAG_WORKSPACE_SHA256[:12]}"
    )
    if (
        not MATERIAL_RAG_CONTROL_DIR.is_absolute()
        or MATERIAL_RAG_CONTROL_DIR.parent != Path("/private/tmp")
        or MATERIAL_RAG_CONTROL_DIR.name != expected_name
        or not re.fullmatch(
            r"anhuan-material-rag-control-[0-9a-f]{12}", expected_name
        )
    ):
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID")
    try:
        root_info = MATERIAL_RAG_CONTROL_DIR.lstat()
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID") from None
    if (
        not stat.S_ISDIR(root_info.st_mode)
        or stat.S_ISLNK(root_info.st_mode)
        or stat.S_IMODE(root_info.st_mode) != 0o700
        or root_info.st_uid != os.geteuid()
    ):
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID")

    docker_directory = MATERIAL_RAG_CONTROL_HOME_DIR / ".docker"
    required_entries = {
        MATERIAL_RAG_CONTROL_STATE_FILE.name,
        MATERIAL_RAG_CONTROL_LOCK_FILE.name,
        MATERIAL_RAG_CONTROL_HOME_DIR.name,
        MATERIAL_RAG_CONTROL_TMP_DIR.name,
    }
    try:
        observed_entries = {
            entry.name for entry in os.scandir(MATERIAL_RAG_CONTROL_DIR)
        }
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID") from None
    if observed_entries != required_entries:
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID")
    for directory in (
        MATERIAL_RAG_CONTROL_HOME_DIR,
        MATERIAL_RAG_CONTROL_TMP_DIR,
        docker_directory,
    ):
        try:
            info = directory.lstat()
        except OSError:
            raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID") from None
        if (
            not stat.S_ISDIR(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or stat.S_IMODE(info.st_mode) != 0o700
            or info.st_uid != os.geteuid()
            or info.st_dev != root_info.st_dev
        ):
            raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID")

    _secure_file(MATERIAL_RAG_CONTROL_STATE_FILE, maximum=4096)
    _secure_file(MATERIAL_RAG_CONTROL_LOCK_FILE, minimum=0, maximum=0)
    _secure_file(docker_directory / "config.json", maximum=4096)
    expected_state = (
        json.dumps(
            _material_rag_control_state(),
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    ).encode("ascii")
    try:
        observed_state = MATERIAL_RAG_CONTROL_STATE_FILE.read_bytes()
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_STATE_INVALID") from None
    if observed_state != expected_state:
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_STATE_INVALID")

    pending = [MATERIAL_RAG_CONTROL_DIR]
    while pending:
        directory = pending.pop()
        try:
            entries = list(os.scandir(directory))
        except OSError:
            raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID") from None
        for entry in entries:
            try:
                info = entry.stat(follow_symlinks=False)
            except OSError:
                raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID") from None
            if (
                stat.S_ISLNK(info.st_mode)
                or info.st_uid != os.geteuid()
                or info.st_dev != root_info.st_dev
            ):
                raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID")
            path = Path(entry.path)
            docker_dir = MATERIAL_RAG_CONTROL_HOME_DIR / ".docker"
            ephemeral = (
                path == MATERIAL_RAG_CONTROL_TMP_DIR
                or MATERIAL_RAG_CONTROL_TMP_DIR in path.parents
                or path == docker_dir
                or docker_dir in path.parents
            )
            if not (
                stat.S_ISDIR(info.st_mode)
                or stat.S_ISREG(info.st_mode)
                or (
                    ephemeral
                    and (stat.S_ISSOCK(info.st_mode) or stat.S_ISFIFO(info.st_mode))
                )
            ):
                raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_ROOT_INVALID")
            if stat.S_ISDIR(info.st_mode):
                pending.append(path)
    try:
        shutil.rmtree(MATERIAL_RAG_CONTROL_DIR)
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_CLEANUP_FAILED") from None
    try:
        MATERIAL_RAG_CONTROL_DIR.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_CLEANUP_FAILED") from None
    raise LocalError("LOCAL_MATERIAL_RAG_CONTROL_CLEANUP_FAILED")


def _write_compose_env(state: dict[str, object]) -> None:
    origin = f"http://127.0.0.1:{int(state['web_port'])}"
    values = {
        "LOCAL_DATABASE": state["database"],
        "LOCAL_GID": os.getegid(),
        "LOCAL_PROJECT_ID": state["project_id"],
        "LOCAL_RUNTIME_IMAGE": state["runtime_image"],
        "LOCAL_SECRETS_DIR": str(SECRETS_DIR),
        "LOCAL_UID": os.geteuid(),
        "LOCAL_WEB_IMAGE": state["web_image"],
        "LOCAL_WEB_ORIGIN": origin,
        "LOCAL_WEB_PORT": state["web_port"],
    }
    data = "".join(f"{key}={values[key]}\n" for key in sorted(values)).encode(
        "utf-8"
    )
    if ENV_FILE.exists():
        _secure_file(ENV_FILE, maximum=16384)
        observed = ENV_FILE.read_bytes()
        previous_values = {
            key: value
            for key, value in values.items()
            if key not in {"LOCAL_GID", "LOCAL_UID"}
        }
        previous_data = "".join(
            f"{key}={previous_values[key]}\n"
            for key in sorted(previous_values)
        ).encode("utf-8")
        if observed == previous_data:
            _atomic_replace(ENV_FILE, data)
        elif observed != data:
            raise LocalError("LOCAL_COMPOSE_ENV_DRIFT")
    else:
        _exclusive_write(ENV_FILE, data)


def _initialize() -> dict[str, object]:
    if not STATE_DIR.exists():
        STATE_DIR.mkdir(mode=0o700)
    _directory(STATE_DIR)
    for directory in (SECRETS_DIR, BACKUPS_DIR, HOME_DIR, TMP_DIR):
        if not directory.exists():
            directory.mkdir(mode=0o700)
        _directory(directory)

    if STATE_FILE.exists():
        state = _read_state()
    else:
        state = _new_state()
        payload = (
            json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n"
        ).encode("ascii")
        _exclusive_write(STATE_FILE, payload)
    _write_secrets(state)
    _validate_secret_set()
    _write_docker_config()
    _write_compose_env(state)
    return state


def _docker() -> str:
    raw = shutil.which("docker")
    if raw is None:
        raise LocalError("LOCAL_DOCKER_UNAVAILABLE")
    resolved = Path(raw).resolve(strict=True)
    info = resolved.stat()
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
        or not os.access(resolved, os.X_OK)
    ):
        raise LocalError("LOCAL_DOCKER_UNTRUSTED")
    return str(resolved)


def _environment() -> dict[str, str]:
    return {
        "DOCKER_CONFIG": str(HOME_DIR / ".docker"),
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "HOME": str(HOME_DIR),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "NO_PROXY": "127.0.0.1,localhost,postgres,keycloak,minio,redis,clamd,api,web",
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "TMPDIR": str(TMP_DIR),
        "no_proxy": "127.0.0.1,localhost,postgres,keycloak,minio,redis,clamd,api,web",
    }


def _material_rag_environment() -> dict[str, str]:
    service_names = (
        "material-rag-postgres",
        "material-rag-minio",
        "material-rag-redis",
        "material-rag-clamd",
        "material-rag-mysql",
        "material-rag-es",
        "material-rag-objectstore",
        "material-rag-cache",
        "material-rag-egress-proxy",
        "material-rag-ocr",
        "material-rag-ragflow",
    )
    no_proxy = ",".join(("127.0.0.1", "localhost", *service_names))
    return {
        "DOCKER_CONFIG": str(MATERIAL_RAG_CONTROL_HOME_DIR / ".docker"),
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "HOME": str(MATERIAL_RAG_CONTROL_HOME_DIR),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "NO_PROXY": no_proxy,
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "TMPDIR": str(MATERIAL_RAG_CONTROL_TMP_DIR),
        "no_proxy": no_proxy,
    }


def _compose_base(state: dict[str, object]) -> list[str]:
    return [
        _docker(),
        "compose",
        "--ansi",
        "never",
        "--project-name",
        str(state["compose_project"]),
        "--env-file",
        str(ENV_FILE),
        "-f",
        str(COMPOSE_FILE),
        "--profile",
        "ops",
    ]


def _run(
    arguments: list[str],
    *,
    capture: bool = False,
    timeout: int = 600,
    check: bool = True,
    environment_overrides: dict[str, str] | None = None,
    material_rag: bool = False,
) -> subprocess.CompletedProcess[str]:
    environment = _material_rag_environment() if material_rag else _environment()
    if environment_overrides:
        if set(environment_overrides) - {
            "LOCAL_PWA_UPDATE_PROBE",
            "LOCAL_WEB_IMAGE",
        }:
            raise LocalError("LOCAL_ENVIRONMENT_OVERRIDE_INVALID")
        for key, value in environment_overrides.items():
            if (
                not isinstance(value, str)
                or not value
                or not value.isascii()
                or "\x00" in value
                or "\n" in value
                or "\r" in value
            ):
                raise LocalError("LOCAL_ENVIRONMENT_OVERRIDE_INVALID")
            environment[key] = value
    try:
        result = subprocess.run(
            arguments,
            cwd=ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        raise LocalError("LOCAL_COMMAND_FAILED") from None
    if check and result.returncode != 0:
        raise LocalError("LOCAL_COMMAND_FAILED")
    return result


def _compose(
    state: dict[str, object],
    *arguments: str,
    capture: bool = False,
    timeout: int = 600,
    environment_overrides: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return _run(
        [*_compose_base(state), *arguments],
        capture=capture,
        timeout=timeout,
        environment_overrides=environment_overrides,
    )


def _material_rag_identity(
    state: dict[str, object],
) -> tuple[str, str, str, str]:
    parent_id = str(state["project_id"])
    digest = hashlib.sha256(
        f"anhuan-material-rag-v1:{parent_id}".encode("ascii")
    ).hexdigest()
    project = f"anhuan-material-rag-{digest[:12]}"
    project_id = str(
        uuid.uuid5(uuid.UUID(parent_id), "anhuan-material-rag-verification-v1")
    )
    database = f"anhuan_material_rag_{digest[:24]}"
    if not MATERIAL_RAG_PROJECT_RE.fullmatch(project):
        raise LocalError("LOCAL_MATERIAL_RAG_IDENTITY_INVALID")
    return project, project_id, database, digest[:12]


def _material_rag_private_root(state: dict[str, object]) -> Path:
    return Path("/private/tmp") / (
        f"anhuan-material-rag-{_material_rag_identity(state)[3]}"
    )


def _material_rag_runtime_image(state: dict[str, object]) -> str:
    image = f"anhuan-material-rag-runtime:{_material_rag_identity(state)[3]}"
    if not MATERIAL_RAG_RUNTIME_IMAGE_RE.fullmatch(image):
        raise LocalError("LOCAL_MATERIAL_RAG_IDENTITY_INVALID")
    return image


def _remove_material_rag_private_root(path: Path) -> None:
    if not path.exists():
        return
    try:
        info = path.lstat()
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_PRIVATE_ROOT_INVALID") from None
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise LocalError("LOCAL_MATERIAL_RAG_PRIVATE_ROOT_INVALID")
    try:
        shutil.rmtree(path)
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_PRIVATE_ROOT_CLEANUP_FAILED") from None


def _read_material_rag_fixture_file(
    path: Path, *, expected_sha256: str, maximum_bytes: int
) -> bytes:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(
        os, "O_NOFOLLOW", 0
    )
    try:
        descriptor = os.open(path, flags)
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_FIXTURE_UNAVAILABLE") from None
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or before.st_mode & 0o022
            or not 1 <= before.st_size <= maximum_bytes
        ):
            raise LocalError("LOCAL_MATERIAL_RAG_FIXTURE_INVALID")
        chunks: list[bytes] = []
        digest = hashlib.sha256()
        total = 0
        while True:
            chunk = os.read(descriptor, min(1024 * 1024, maximum_bytes + 1 - total))
            if not chunk:
                break
            total += len(chunk)
            if total > maximum_bytes:
                raise LocalError("LOCAL_MATERIAL_RAG_FIXTURE_INVALID")
            digest.update(chunk)
            chunks.append(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    identity = lambda value: (
        value.st_dev,
        value.st_ino,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )
    if identity(before) != identity(after) or digest.hexdigest() != expected_sha256:
        raise LocalError("LOCAL_MATERIAL_RAG_FIXTURE_CHANGED")
    return b"".join(chunks)


def _material_rag_demo_sources() -> tuple[tuple[str, Path, str], ...]:
    try:
        root_info = MATERIAL_RAG_DEMO_ROOT.lstat()
    except OSError:
        raise LocalError("LOCAL_MATERIAL_RAG_DEMO_ROOT_INVALID") from None
    if (
        not MATERIAL_RAG_DEMO_ROOT.is_absolute()
        or not stat.S_ISDIR(root_info.st_mode)
        or stat.S_ISLNK(root_info.st_mode)
        or root_info.st_uid != os.geteuid()
        or root_info.st_mode & 0o022
    ):
        raise LocalError("LOCAL_MATERIAL_RAG_DEMO_ROOT_INVALID")
    manifest = _read_material_rag_fixture_file(
        MATERIAL_RAG_CORE_MANIFEST_FILE,
        expected_sha256=MATERIAL_RAG_CORE_MANIFEST_SHA256,
        maximum_bytes=64 * 1024,
    )
    try:
        lines = manifest.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        raise LocalError("LOCAL_MATERIAL_RAG_MANIFEST_INVALID") from None
    parsed: list[tuple[str, str]] = []
    for line in lines:
        matched = re.fullmatch(r"([0-9a-f]{64})  ([^\x00\r\n]+)", line)
        if matched is None:
            raise LocalError("LOCAL_MATERIAL_RAG_MANIFEST_INVALID")
        parsed.append((matched.group(1), matched.group(2)))
    if len(parsed) != 24 or len({value[0] for value in parsed}) != 24:
        raise LocalError("LOCAL_MATERIAL_RAG_MANIFEST_INVALID")

    sources: list[tuple[str, Path, str]] = []
    for environment_name, line_number, expected_sha256 in MATERIAL_RAG_DEMO_SPECS:
        actual_sha256, relative_value = parsed[line_number - 1]
        relative = Path(relative_value)
        if (
            actual_sha256 != expected_sha256
            or relative.is_absolute()
            or ".." in relative.parts
            or relative.suffix.lower() != ".pdf"
        ):
            raise LocalError("LOCAL_MATERIAL_RAG_MANIFEST_INVALID")
        candidate = MATERIAL_RAG_DEMO_ROOT / relative
        current = MATERIAL_RAG_DEMO_ROOT
        for component in relative.parts[:-1]:
            current /= component
            try:
                directory_info = current.lstat()
            except OSError:
                raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_INVALID") from None
            if (
                not stat.S_ISDIR(directory_info.st_mode)
                or stat.S_ISLNK(directory_info.st_mode)
                or directory_info.st_uid != os.geteuid()
            ):
                raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_INVALID")
        sources.append((environment_name, candidate, expected_sha256))
    if len({source[1] for source in sources}) != len(MATERIAL_RAG_DEMO_SPECS):
        raise LocalError("LOCAL_MATERIAL_RAG_MANIFEST_INVALID")
    return tuple(sources)


def _snapshot_material_rag_demo_sources(root: Path) -> None:
    snapshot_directory = root / "demo"
    snapshot_directory.mkdir(mode=0o700)
    _directory(snapshot_directory)
    for _environment_name, source, expected_sha256 in _material_rag_demo_sources():
        source_descriptor = -1
        target_descriptor = -1
        target = snapshot_directory / f"{expected_sha256}.pdf"
        digest = hashlib.sha256()
        try:
            source_descriptor = os.open(
                source,
                os.O_RDONLY
                | getattr(os, "O_CLOEXEC", 0)
                | getattr(os, "O_NOFOLLOW", 0),
            )
            before = os.fstat(source_descriptor)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_nlink != 1
                or before.st_uid != os.geteuid()
                or not 8 <= before.st_size <= 64 * 1024 * 1024
            ):
                raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_INVALID")
            target_descriptor = os.open(
                target,
                os.O_WRONLY
                | os.O_CREAT
                | os.O_EXCL
                | getattr(os, "O_CLOEXEC", 0)
                | getattr(os, "O_NOFOLLOW", 0),
                0o600,
            )
            while chunk := os.read(source_descriptor, 1024 * 1024):
                digest.update(chunk)
                view = memoryview(chunk)
                while view:
                    written = os.write(target_descriptor, view)
                    if written < 1:
                        raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_INVALID")
                    view = view[written:]
            os.fsync(target_descriptor)
            after = os.fstat(source_descriptor)
            target_info = os.fstat(target_descriptor)
        except OSError:
            raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_INVALID") from None
        finally:
            if target_descriptor >= 0:
                os.close(target_descriptor)
            if source_descriptor >= 0:
                os.close(source_descriptor)
        identity = lambda value: (
            value.st_dev,
            value.st_ino,
            value.st_size,
            value.st_mtime_ns,
            value.st_ctime_ns,
        )
        if (
            identity(before) != identity(after)
            or digest.hexdigest() != expected_sha256
            or target_info.st_size != before.st_size
            or target_info.st_nlink != 1
            or stat.S_IMODE(target_info.st_mode) != 0o600
            or target_info.st_uid != os.geteuid()
        ):
            raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_CHANGED")


def _prepare_material_rag_private_root(
    state: dict[str, object],
) -> tuple[Path, Path, str]:
    _read_material_rag_fixture_file(
        MATERIAL_RAG_NATIVE_PLAN_FILE,
        expected_sha256=MATERIAL_RAG_NATIVE_PLAN_SHA256,
        maximum_bytes=4 * 1024 * 1024,
    )
    for _environment_name, source, expected_sha256 in _material_rag_demo_sources():
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(
            os, "O_NOFOLLOW", 0
        )
        try:
            descriptor = os.open(source, flags)
        except OSError:
            raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_UNAVAILABLE") from None
        try:
            before = os.fstat(descriptor)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_nlink != 1
                or before.st_uid != os.geteuid()
                or not 1 <= before.st_size <= 64 * 1024 * 1024
            ):
                raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_INVALID")
            digest = hashlib.sha256()
            while chunk := os.read(descriptor, 1024 * 1024):
                digest.update(chunk)
            after = os.fstat(descriptor)
        finally:
            os.close(descriptor)
        identity = lambda value: (
            value.st_dev,
            value.st_ino,
            value.st_size,
            value.st_mtime_ns,
            value.st_ctime_ns,
        )
        if (
            identity(before) != identity(after)
            or digest.hexdigest() != expected_sha256
        ):
            raise LocalError("LOCAL_MATERIAL_RAG_DEMO_SOURCE_CHANGED")
    try:
        _secure_file(MATERIAL_RAG_ARK_KEY_FILE, minimum=16, maximum=16384)
    except LocalError:
        raise LocalError("LOCAL_MATERIAL_RAG_ARK_KEY_INVALID") from None

    root = _material_rag_private_root(state)
    _remove_material_rag_private_root(root)
    root.mkdir(mode=0o700)
    _directory(root)
    try:
        _snapshot_material_rag_demo_sources(root)
    except LocalError:
        _remove_material_rag_private_root(root)
        raise
    secrets_directory = root / "secrets"
    secrets_directory.mkdir(mode=0o700)
    _directory(secrets_directory)

    _project, _project_id, database, _probe = _material_rag_identity(state)
    passwords = {
        name: _secret_value()
        for name in (
            "f0d_bootstrap_password",
            "f0d_migration_password",
            "f0d_runtime_password",
            "f0d_worker_password",
            "f1_api_password",
            "f1_worker_password",
            "minio_root_password",
            "ragflow_bootstrap_password",
        )
    }
    passwords["minio_root_user"] = "material" + secrets.token_hex(10)
    passwords["f1_qa_key"] = secrets.token_hex(32)
    passwords["f1_material_rag_key"] = secrets.token_hex(32)
    passwords["f1_material_rag_manifest_key"] = secrets.token_hex(32)
    while (
        passwords["f1_material_rag_manifest_key"]
        == passwords["f1_material_rag_key"]
    ):
        passwords["f1_material_rag_manifest_key"] = secrets.token_hex(32)
    passwords["material_rag_internal_password"] = _secret_value()
    bootstrap = quote(passwords["f0d_bootstrap_password"], safe="")
    migration = quote(passwords["f0d_migration_password"], safe="")
    passwords["f0d_migration_dsn"] = (
        "postgresql://f0d_migration:"
        f"{migration}@material-rag-postgres:5432/{database}"
    )
    passwords["f1_bootstrap_dsn"] = (
        "postgresql://f0d_bootstrap:"
        f"{bootstrap}@material-rag-postgres:5432/{database}"
    )
    passwords["f1_migration_dsn"] = passwords["f0d_migration_dsn"]
    for name, value in passwords.items():
        _exclusive_write(secrets_directory / name, value.encode("ascii"))
    _exclusive_write(secrets_directory / "f0i_key", secrets.token_bytes(32))
    return root, secrets_directory, passwords["material_rag_internal_password"]


def _write_material_rag_env(
    state: dict[str, object],
    root: Path,
    secrets_directory: Path,
    internal_password: str,
    *,
    registration_enabled: bool,
) -> Path:
    project, project_id, database, _probe = _material_rag_identity(state)
    values = {
        "LOCAL_MATERIAL_RAG_ARK_KEY_FILE": str(MATERIAL_RAG_ARK_KEY_FILE),
        "LOCAL_MATERIAL_RAG_DATABASE": database,
        "LOCAL_MATERIAL_RAG_DISABLE_PASSWORD_LOGIN": (
            "false" if registration_enabled else "true"
        ),
        "LOCAL_MATERIAL_RAG_INTERNAL_PASSWORD": internal_password,
        "LOCAL_MATERIAL_RAG_PROJECT_ID": project_id,
        "LOCAL_MATERIAL_RAG_REGISTER_ENABLED": (
            "1" if registration_enabled else "0"
        ),
        "LOCAL_MATERIAL_RAG_SECRETS_DIR": str(secrets_directory),
        "LOCAL_PARENT_PROJECT_ID": str(state["project_id"]),
        "LOCAL_MATERIAL_RAG_RUNTIME_IMAGE": _material_rag_runtime_image(state),
    }
    values["LOCAL_MATERIAL_RAG_CORE_MANIFEST_FILE"] = str(
        MATERIAL_RAG_CORE_MANIFEST_FILE
    )
    values["LOCAL_MATERIAL_RAG_NATIVE_PLAN_FILE"] = str(
        MATERIAL_RAG_NATIVE_PLAN_FILE
    )
    for environment_name, _line_number, expected_sha256 in MATERIAL_RAG_DEMO_SPECS:
        values[environment_name] = str(root / "demo" / f"{expected_sha256}.pdf")
    if any(
        not isinstance(value, str)
        or not value
        or "\x00" in value
        or "\n" in value
        or "\r" in value
        for value in values.values()
    ):
        raise LocalError("LOCAL_MATERIAL_RAG_ENV_INVALID")
    path = root / "compose.env"
    data = "".join(f"{key}={values[key]}\n" for key in sorted(values)).encode(
        "utf-8"
    )
    if path.exists():
        _atomic_replace(path, data)
    else:
        _exclusive_write(path, data)
    if project != _material_rag_identity(state)[0]:
        raise LocalError("LOCAL_MATERIAL_RAG_IDENTITY_INVALID")
    return path


def _material_rag_compose_base(
    state: dict[str, object], env_file: Path
) -> list[str]:
    project, _project_id, _database, _probe = _material_rag_identity(state)
    return [
        _docker(),
        "compose",
        "--ansi",
        "never",
        "--progress",
        "quiet",
        "--project-name",
        project,
        "--env-file",
        str(env_file),
        "-f",
        str(MATERIAL_RAG_COMPOSE_FILE),
    ]


def _material_rag_compose(
    state: dict[str, object],
    env_file: Path,
    *arguments: str,
    capture: bool = False,
    timeout: int = 600,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    return _run(
        [*_material_rag_compose_base(state, env_file), *arguments],
        capture=capture,
        timeout=timeout,
        check=check,
        material_rag=True,
    )


_MATERIAL_RAG_BUILD_EVIDENCE_PREFIX = "LOCAL_MATERIAL_RAG_BUILD_EVIDENCE "
_MATERIAL_RAG_BUILD_EVIDENCE_KEYS = frozenset(
    {"detail_class", "exit_class", "exit_code", "phase"}
)
_MATERIAL_RAG_BUILD_EXIT_CLASSES = frozenset(
    {"DNS", "HASH", "NO_SPACE", "OTHER", "TIMEOUT", "TLS", "UNKNOWN"}
)
_MATERIAL_RAG_BUILD_PHASES = frozenset({"DEPENDENCY_INSTALL", "OTHER", "UNKNOWN"})
_MATERIAL_RAG_BUILD_DETAIL_CLASSES = frozenset(
    {
        "DNS",
        "HASH",
        "NETWORK_TIMEOUT",
        "NO_SPACE",
        "OTHER",
        "TLS_EOF",
        "TLS_OTHER",
        "UNKNOWN",
    }
)
_MATERIAL_RAG_IMAGE_SOURCE_CLOSED = (
