class LocalError(RuntimeError):
    pass


def _directory(path: Path) -> None:
    if not path.exists():
        path.mkdir(mode=0o700, parents=False)
    info = path.lstat()
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o700
        or info.st_uid != os.geteuid()
    ):
        raise LocalError("LOCAL_DIRECTORY_PERMISSIONS_INVALID")


def _secure_file(path: Path, *, minimum: int = 1, maximum: int = 16384) -> None:
    try:
        info = path.lstat()
    except OSError:
        raise LocalError("LOCAL_FILE_MISSING") from None
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_nlink != 1
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_uid != os.geteuid()
        or info.st_size < minimum
        or info.st_size > maximum
    ):
        raise LocalError("LOCAL_FILE_PERMISSIONS_INVALID")


def _exclusive_write(path: Path, data: bytes) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o600)
    try:
        written = os.write(descriptor, data)
        if written != len(data):
            raise LocalError("LOCAL_FILE_WRITE_INCOMPLETE")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    _secure_file(path, minimum=len(data), maximum=len(data))


def _atomic_replace(path: Path, data: bytes) -> None:
    temporary = path.with_name(path.name + ".new")
    if temporary.exists():
        raise LocalError("LOCAL_STAGING_FILE_EXISTS")
    _exclusive_write(temporary, data)
    os.replace(temporary, path)
    _secure_file(path, minimum=len(data), maximum=max(len(data), 65536))


def _free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as stream:
        stream.bind(("127.0.0.1", 0))
        return int(stream.getsockname()[1])


def _new_state() -> dict[str, object]:
    run = secrets.token_hex(12)
    return {
        "schema": STATE_SCHEMA,
        "project_id": str(uuid.uuid4()),
        "compose_project": f"anhuan-closeout-{run[:12]}",
        "database": f"anhuan_closeout_{run}",
        "web_port": _free_port(),
        "runtime_image": f"anhuan-closeout-runtime:{run[:12]}",
        "web_image": f"anhuan-closeout-web:{run[:12]}",
    }


def _validate_state(state: object) -> dict[str, object]:
    if not isinstance(state, dict) or set(state) != {
        "schema",
        "project_id",
        "compose_project",
        "database",
        "web_port",
        "runtime_image",
        "web_image",
    }:
        raise LocalError("LOCAL_STATE_INVALID")
    try:
        uuid.UUID(str(state["project_id"]))
        port = int(state["web_port"])
    except (TypeError, ValueError):
        raise LocalError("LOCAL_STATE_INVALID") from None
    if (
        state["schema"] != STATE_SCHEMA
        or not PROJECT_RE.fullmatch(str(state["compose_project"]))
        or not DATABASE_RE.fullmatch(str(state["database"]))
        or not 1024 <= port <= 65535
        or state["runtime_image"]
        != f"anhuan-closeout-runtime:{str(state['compose_project'])[-12:]}"
        or state["web_image"]
        != f"anhuan-closeout-web:{str(state['compose_project'])[-12:]}"
    ):
        raise LocalError("LOCAL_STATE_INVALID")
    return state


def _read_state() -> dict[str, object]:
    _secure_file(STATE_FILE, maximum=16384)
    try:
        state = json.loads(STATE_FILE.read_text(encoding="ascii"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        raise LocalError("LOCAL_STATE_INVALID") from None
    return _validate_state(state)


def _secret_value() -> str:
    return secrets.token_urlsafe(36)


def _write_secrets(state: dict[str, object]) -> None:
    existing = {name for name in ALL_SECRET_NAMES if (SECRETS_DIR / name).exists()}
    if existing:
        if existing != set(ALL_SECRET_NAMES):
            raise LocalError("LOCAL_SECRET_SET_INCOMPLETE")
        return
    passwords = {
        name: _secret_value()
        for name in TEXT_SECRET_NAMES
        if name not in {
            "f0d_migration_dsn",
            "f1_bootstrap_dsn",
            "f1_migration_dsn",
            "minio_root_user",
            "f1_qa_key",
        }
    }
    passwords["minio_root_user"] = "local" + secrets.token_hex(12)
    passwords["f1_qa_key"] = secrets.token_hex(32)
    database = str(state["database"])
    bootstrap_password = quote(passwords["f0d_bootstrap_password"], safe="")
    migration_password = quote(passwords["f0d_migration_password"], safe="")
    passwords["f0d_migration_dsn"] = (
        "postgresql://f0d_migration:"
        f"{migration_password}@postgres:5432/{database}"
    )
    passwords["f1_bootstrap_dsn"] = (
        "postgresql://f0d_bootstrap:"
        f"{bootstrap_password}@postgres:5432/{database}"
    )
    passwords["f1_migration_dsn"] = passwords["f0d_migration_dsn"]

    for name in TEXT_SECRET_NAMES:
        path = SECRETS_DIR / name
        if not path.exists():
            _exclusive_write(path, passwords[name].encode("ascii"))
    f0i_path = SECRETS_DIR / "f0i_key"
    if not f0i_path.exists():
        _exclusive_write(f0i_path, secrets.token_bytes(32))


def _validate_secret_set(directory: Path | None = None) -> None:
    if directory is None:
        directory = SECRETS_DIR
    _directory(directory)
    try:
        entries = {entry.name for entry in os.scandir(directory)}
    except OSError:
        raise LocalError("LOCAL_SECRET_SET_INVALID") from None
    if entries != set(ALL_SECRET_NAMES):
        raise LocalError("LOCAL_SECRET_SET_INVALID")
    for name in ALL_SECRET_NAMES:
        expected = 32 if name == "f0i_key" else 1
        maximum = 32 if name == "f0i_key" else 16384
        _secure_file(directory / name, minimum=expected, maximum=maximum)


def _validate_existing_layout() -> None:
    for directory in (SECRETS_DIR, BACKUPS_DIR, HOME_DIR, TMP_DIR):
        _directory(directory)
    _validate_secret_set()


def _docker_plugin_directory() -> str | None:
    candidate = Path(
        "/Applications/Docker.app/Contents/Resources/cli-plugins"
    )
    executable = candidate / "docker-compose"
    if not executable.exists():
        return None
    resolved = executable.resolve(strict=True)
    info = resolved.stat()
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
        or not os.access(resolved, os.X_OK)
    ):
        raise LocalError("LOCAL_COMPOSE_PLUGIN_UNTRUSTED")
    return str(candidate)


def _write_docker_config() -> None:
    docker_dir = HOME_DIR / ".docker"
    if not docker_dir.exists():
        docker_dir.mkdir(mode=0o700)
    _directory(docker_dir)
    plugin_dir = _docker_plugin_directory()
    payload: dict[str, object] = {}
    if plugin_dir is not None:
        payload["cliPluginsExtraDirs"] = [plugin_dir]
    data = (json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "ascii"
    )
    path = docker_dir / "config.json"
    if path.exists():
        _secure_file(path, maximum=4096)
        if path.read_bytes() != data:
            raise LocalError("LOCAL_DOCKER_CONFIG_DRIFT")
    else:
        _exclusive_write(path, data)


def _write_compose_env(state: dict[str, object]) -> None:
    origin = f"http://127.0.0.1:{int(state['web_port'])}"
    values = {
        "LOCAL_DATABASE": state["database"],
        "LOCAL_GID": os.getegid(),
        "LOCAL_PROJECT_ID": state["project_id"],
        "LOCAL_RUNTIME_IMAGE": state["runtime_image"],
        "LOCAL_SECRETS_DIR": str(SECRETS_DIR),
        "LOCAL_UID": os.geteuid(),
        "LOCAL_WEB_IMAGE": state["web_image"],
        "LOCAL_WEB_ORIGIN": origin,
        "LOCAL_WEB_PORT": state["web_port"],
    }
    data = "".join(f"{key}={values[key]}\n" for key in sorted(values)).encode(
        "utf-8"
    )
    if ENV_FILE.exists():
        _secure_file(ENV_FILE, maximum=16384)
        observed = ENV_FILE.read_bytes()
        previous_values = {
            key: value
            for key, value in values.items()
            if key not in {"LOCAL_GID", "LOCAL_UID"}
        }
        previous_data = "".join(
            f"{key}={previous_values[key]}\n"
            for key in sorted(previous_values)
        ).encode("utf-8")
        if observed == previous_data:
            _atomic_replace(ENV_FILE, data)
        elif observed != data:
            raise LocalError("LOCAL_COMPOSE_ENV_DRIFT")
    else:
        _exclusive_write(ENV_FILE, data)


def _initialize() -> dict[str, object]:
    if not STATE_DIR.exists():
        STATE_DIR.mkdir(mode=0o700)
    _directory(STATE_DIR)
    for directory in (SECRETS_DIR, BACKUPS_DIR, HOME_DIR, TMP_DIR):
        if not directory.exists():
            directory.mkdir(mode=0o700)
        _directory(directory)

    if STATE_FILE.exists():
        state = _read_state()
    else:
        state = _new_state()
        payload = (
            json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n"
        ).encode("ascii")
        _exclusive_write(STATE_FILE, payload)
    _write_secrets(state)
    _validate_secret_set()
    _write_docker_config()
    _write_compose_env(state)
    return state


def _docker() -> str:
    raw = shutil.which("docker")
    if raw is None:
        raise LocalError("LOCAL_DOCKER_UNAVAILABLE")
    resolved = Path(raw).resolve(strict=True)
    info = resolved.stat()
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
        or not os.access(resolved, os.X_OK)
    ):
        raise LocalError("LOCAL_DOCKER_UNTRUSTED")
    return str(resolved)


def _environment() -> dict[str, str]:
    return {
        "DOCKER_CONFIG": str(HOME_DIR / ".docker"),
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "HOME": str(HOME_DIR),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "NO_PROXY": "127.0.0.1,localhost,postgres,keycloak,minio,redis,clamd,api,web",
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "TMPDIR": str(TMP_DIR),
        "no_proxy": "127.0.0.1,localhost,postgres,keycloak,minio,redis,clamd,api,web",
    }


def _compose_base(state: dict[str, object]) -> list[str]:
    return [
        _docker(),
        "compose",
        "--ansi",
        "never",
        "--project-name",
        str(state["compose_project"]),
        "--env-file",
        str(ENV_FILE),
        "-f",
        str(COMPOSE_FILE),
        "--profile",
        "ops",
    ]


def _run(
    arguments: list[str],
    *,
    capture: bool = False,
    timeout: int = 600,
    check: bool = True,
    environment_overrides: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    environment = _environment()
    if environment_overrides:
        if set(environment_overrides) - {
            "LOCAL_PWA_UPDATE_PROBE",
            "LOCAL_WEB_IMAGE",
        }:
            raise LocalError("LOCAL_ENVIRONMENT_OVERRIDE_INVALID")
        for key, value in environment_overrides.items():
            if (
                not isinstance(value, str)
                or not value
                or not value.isascii()
                or "\x00" in value
                or "\n" in value
                or "\r" in value
            ):
                raise LocalError("LOCAL_ENVIRONMENT_OVERRIDE_INVALID")
            environment[key] = value
    try:
        result = subprocess.run(
            arguments,
            cwd=ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        raise LocalError("LOCAL_COMMAND_FAILED") from None
    if check and result.returncode != 0:
        raise LocalError("LOCAL_COMMAND_FAILED")
    return result


def _compose(
    state: dict[str, object],
    *arguments: str,
    capture: bool = False,
    timeout: int = 600,
    environment_overrides: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return _run(
        [*_compose_base(state), *arguments],
        capture=capture,
        timeout=timeout,
        environment_overrides=environment_overrides,
    )


def _contract_failure_reason(
    stderr: str, allowed_reasons: frozenset[str]
) -> str | None:
    if not isinstance(stderr, str) or len(stderr.encode("utf-8")) > 8192:
        return None
    matches = [line for line in stderr.splitlines() if line in allowed_reasons]
    if len(matches) != 1:
        return None
    return matches[0]


def _compose_contract(
    state: dict[str, object],
    service: str,
    *,
    timeout: int,
) -> subprocess.CompletedProcess[str]:
    allowed_reasons = VERIFIER_FAILURE_REASONS.get(service)
    if allowed_reasons is None:
        raise LocalError("LOCAL_CONTRACT_SERVICE_INVALID")
    result = _run(
        [*_compose_base(state), "run", "--rm", service],
        capture=True,
        timeout=timeout,
        check=False,
    )
    if result.returncode != 0:
        reason = _contract_failure_reason(result.stderr, allowed_reasons)
        raise LocalError(reason or "LOCAL_COMMAND_FAILED")
    return result


def _node() -> str:
    raw = shutil.which("node", path=_environment()["PATH"])
    if raw is None:
        raise LocalError("LOCAL_NODE_UNAVAILABLE")
    resolved = Path(raw).resolve(strict=True)
    info = resolved.stat()
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
        or not os.access(resolved, os.X_OK)
    ):
        raise LocalError("LOCAL_NODE_UNTRUSTED")
    return str(resolved)


def _python() -> str:
    candidates = (Path(sys.executable), Path("/usr/bin/python3"))
    observed = False
    for candidate in candidates:
        try:
            resolved = candidate.resolve(strict=True)
            info = resolved.stat()
        except OSError:
            continue
        observed = True
        if (
            stat.S_ISREG(info.st_mode)
            and info.st_uid in {0, os.geteuid()}
            and not info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
            and os.access(resolved, os.X_OK)
        ):
            return str(resolved)
    raise LocalError(
        "LOCAL_PYTHON_UNTRUSTED" if observed else "LOCAL_PYTHON_UNAVAILABLE"
    )


def _git() -> str:
    raw = shutil.which("git", path=_environment()["PATH"])
    if raw is None:
        raise LocalError("LOCAL_GIT_UNAVAILABLE")
    resolved = Path(raw).resolve(strict=True)
    info = resolved.stat()
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
        or not os.access(resolved, os.X_OK)
    ):
        raise LocalError("LOCAL_GIT_UNTRUSTED")
    return str(resolved)


def _control_signal_present(directory: Path, name: str) -> bool:
    if name not in BROWSER_CONTROL_SIGNALS:
        raise LocalError("LOCAL_PWA_CONTROL_SIGNAL_INVALID")
    path = directory / name
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except FileNotFoundError:
        return False
    except OSError:
        raise LocalError("LOCAL_PWA_CONTROL_SIGNAL_INVALID") from None
    try:
        before = os.fstat(descriptor)
        data = os.read(descriptor, len(PWA_CONTROL_SIGNAL) + 1)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    identity = lambda info: (
        info.st_dev,
        info.st_ino,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or before.st_uid != os.geteuid()
        or stat.S_IMODE(before.st_mode) != 0o600
        or identity(before) != identity(after)
        or data != PWA_CONTROL_SIGNAL
    ):
        raise LocalError("LOCAL_PWA_CONTROL_SIGNAL_INVALID")
    return True


def _wait_for_control_signal(
    directory: Path,
    name: str,
    process: subprocess.Popen[str],
    *,
    timeout: float = 300.0,
) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if _control_signal_present(directory, name):
            return
        if process.poll() is not None:
            _stdout, stderr = process.communicate(timeout=1)
            failure = _browser_failure(stderr)
            if failure is not None:
                raise failure
            raise LocalError("LOCAL_BROWSER_EXIT_WITHOUT_REASON")
        time.sleep(0.075)
    raise LocalError("LOCAL_BROWSER_VERIFY_TIMEOUT")


def _browser_reason_allowed(reason: str) -> bool:
    if reason in BROWSER_FAILURE_REASONS:
        return True
    return bool(
        re.fullmatch(
            r"ADMIN_(?:WORKBENCH|CALENDAR|NOTIFICATIONS|SERVICE_CASES|"
            r"MY_TASKS|FINDINGS|RECTIFICATION|REVIEWS|CONTROLLED_DOCUMENTS|"
            r"DASHBOARD|CRM|REPORTS|POLICIES|POLICY_IMPACT|QUALITY|REHEARSAL|"
            r"INTERNAL_PWA)_API_(?:401|403|404|409|422|500|503|NON_2XX)",
            reason,
        )
    )


def _browser_failure(stderr: str) -> LocalError | None:
    if not isinstance(stderr, str) or len(stderr.encode("utf-8")) > 8192:
        return LocalError("LOCAL_BROWSER_STDERR_INVALID")
    prefix = "LOCAL_BROWSER_VERIFY_FAILED "
    formatted_lines = [line for line in stderr.splitlines() if line.startswith(prefix)]
    if not formatted_lines:
        return None
    if len(formatted_lines) != 1:
        return LocalError("LOCAL_BROWSER_FAILURE_REASON_AMBIGUOUS")
    match = re.fullmatch(
        r"LOCAL_BROWSER_VERIFY_FAILED ([A-Z][A-Z0-9_]{0,79})",
        formatted_lines[0],
    )
    if match is None or not _browser_reason_allowed(match.group(1)):
        return LocalError("LOCAL_BROWSER_FAILURE_REASON_NOT_ALLOWED")
    return LocalError(match.group(1))


def _cleanup_control_directory(directory: Path) -> None:
    if (
        directory.parent != TMP_DIR
        or not re.fullmatch(r"pwa-update-[0-9a-f]{24}", directory.name)
    ):
        raise LocalError("LOCAL_PWA_CONTROL_DIRECTORY_INVALID")
    _directory(directory)
    entries = list(directory.iterdir())
    if any(entry.name not in BROWSER_CONTROL_SIGNALS for entry in entries):
        raise LocalError("LOCAL_PWA_CONTROL_RESIDUAL")
    for entry in entries:
        _secure_file(
            entry,
            minimum=0,
            maximum=len(PWA_CONTROL_SIGNAL),
        )
        body = entry.read_bytes()
        if len(body) == len(PWA_CONTROL_SIGNAL) and body != PWA_CONTROL_SIGNAL:
            raise LocalError("LOCAL_PWA_CONTROL_SIGNAL_INVALID")
        entry.unlink()
    directory.rmdir()


def _cleanup_browser_fault_artifact(control_directory: Path) -> None:
    if (
        control_directory.parent != TMP_DIR
        or not re.fullmatch(r"pwa-update-[0-9a-f]{24}", control_directory.name)
    ):
        raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_INVALID")
    probe = control_directory.name.removeprefix("pwa-update-")
    directory = TMP_DIR / f"anhuan-minio-fault-{probe}"
    try:
        info = directory.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_INVALID") from None
    if (
        directory.parent != TMP_DIR
        or not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o700
        or info.st_uid != os.geteuid()
    ):
        raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_INVALID")
    try:
        entries = list(directory.iterdir())
    except OSError:
        raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_INVALID") from None
    if any(entry.name != MINIO_FAULT_ARTIFACT_NAME for entry in entries):
        raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_INVALID")
    artifact = directory / MINIO_FAULT_ARTIFACT_NAME
    if entries:
        _secure_file(artifact, minimum=0, maximum=4096)
        try:
            artifact.unlink()
        except OSError:
            raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_CLEANUP_FAILED") from None
    try:
        directory.rmdir()
    except OSError:
        raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_CLEANUP_FAILED") from None
    try:
        directory.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_CLEANUP_FAILED") from None
    raise LocalError("LOCAL_BROWSER_FAULT_ARTIFACT_CLEANUP_FAILED")


def _browser_control_directory(probe: str) -> Path:
    if not re.fullmatch(r"[0-9a-f]{24}", probe):
        raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID")
    return TMP_DIR / f"pwa-update-{probe}"


def _browser_compose_receipt(
    state: dict[str, object],
    probe: str,
    *,
    expected_kind: str | None,
    consume: bool,
) -> tuple[str, int] | None:
    if expected_kind is not None and expected_kind not in BROWSER_ACTIVE_COMMANDS:
        raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID")
    control_directory = _browser_control_directory(probe)
    _directory(control_directory)
    staging = (
        control_directory
        / local_browser_compose_supervisor.RECEIPT_STAGING_BASENAME
    )
    try:
        staging.lstat()
    except FileNotFoundError:
        pass
    except OSError:
        raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID") from None
    else:
        raise LocalError("LOCAL_BROWSER_COMMAND_COMPLETION_UNPROVEN")

    directory_flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        directory_flags |= os.O_DIRECTORY
    if hasattr(os, "O_CLOEXEC"):
        directory_flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        directory_flags |= os.O_NOFOLLOW
    try:
        directory_descriptor = os.open(control_directory, directory_flags)
    except OSError:
        raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID") from None
    receipt_descriptor: int | None = None
    try:
        file_flags = os.O_RDONLY
        if hasattr(os, "O_CLOEXEC"):
            file_flags |= os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            file_flags |= os.O_NOFOLLOW
        try:
            receipt_descriptor = os.open(
                local_browser_compose_supervisor.RECEIPT_BASENAME,
                file_flags,
                dir_fd=directory_descriptor,
            )
        except FileNotFoundError:
            return None
        except OSError:
            raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID") from None
        before = os.fstat(receipt_descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_size < 1
            or before.st_size > 4096
        ):
            raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID")
        body = os.read(receipt_descriptor, before.st_size + 1)
        after = os.fstat(receipt_descriptor)
        identity = lambda info: (
            info.st_dev,
            info.st_ino,
            info.st_size,
            info.st_mtime_ns,
            info.st_ctime_ns,
            info.st_mode,
            info.st_uid,
            info.st_nlink,
        )
        if len(body) != before.st_size or identity(before) != identity(after):
            raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID")

        def unique_pairs(items: list[tuple[str, object]]) -> dict[str, object]:
            result: dict[str, object] = {}
            for key, value in items:
                if key in result:
                    raise ValueError("duplicate")
                result[key] = value
            return result

        try:
            document = json.loads(
                body.decode("ascii"), object_pairs_hook=unique_pairs
            )
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
            raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID") from None
        kind = document.get("kind") if isinstance(document, dict) else None
        exit_code = (
            document.get("exit_code") if isinstance(document, dict) else None
        )
        state_body = (
            json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n"
        ).encode("ascii")
        expected = {
            "schema": local_browser_compose_supervisor.SCHEMA,
            "probe": probe,
            "kind": kind,
            "project_id": state["project_id"],
            "compose_project": state["compose_project"],
            "state_sha256": hashlib.sha256(state_body).hexdigest(),
            "service": "web",
            "exit_code": exit_code,
        }
        if (
            not isinstance(document, dict)
            or set(document) != local_browser_compose_supervisor.RECEIPT_FIELDS
            or document != expected
            or kind not in BROWSER_ACTIVE_COMMANDS
            or (expected_kind is not None and kind != expected_kind)
            or type(exit_code) is not int
            or not 0 <= exit_code <= 255
        ):
            raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID")
        if consume:
            try:
                named = os.stat(
                    local_browser_compose_supervisor.RECEIPT_BASENAME,
                    dir_fd=directory_descriptor,
                    follow_symlinks=False,
                )
            except OSError:
                raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID") from None
            if identity(named) != identity(before):
                raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID")
            try:
                os.unlink(
                    local_browser_compose_supervisor.RECEIPT_BASENAME,
                    dir_fd=directory_descriptor,
                )
                os.fsync(directory_descriptor)
            except OSError:
                raise LocalError("LOCAL_BROWSER_RECEIPT_CLEANUP_FAILED") from None
        return str(kind), int(exit_code)
    finally:
        if receipt_descriptor is not None:
            os.close(receipt_descriptor)
        os.close(directory_descriptor)


def _browser_recovery_payload(
    state: dict[str, object],
    probe: str,
    browser_pid: int | None,
    active_command_kind: str | None = None,
    active_command_pid: int | None = None,
) -> dict[str, object]:
    image_a = str(state["web_image"])
    return {
        "schema": BROWSER_RECOVERY_JOURNAL_SCHEMA,
        "project_id": state["project_id"],
        "compose_project": state["compose_project"],
        "probe": probe,
        "image_a": image_a,
        "image_b": f"{image_a}-pwa-update-{probe}",
        "browser_pid": browser_pid,
        "active_command_kind": active_command_kind,
        "active_command_pid": active_command_pid,
    }


def _write_browser_recovery_journal(
    state: dict[str, object], probe: str
) -> None:
    _reconcile_browser_recovery_staging(state)
    staging = BROWSER_RECOVERY_JOURNAL.with_name(
        BROWSER_RECOVERY_JOURNAL.name + ".new"
    )
    if BROWSER_RECOVERY_JOURNAL.exists() or staging.exists():
        raise LocalError("LOCAL_BROWSER_RECOVERY_PENDING")
    body = (
        json.dumps(
            _browser_recovery_payload(state, probe, None),
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    ).encode("ascii")
    _exclusive_write(staging, body)
    os.replace(staging, BROWSER_RECOVERY_JOURNAL)
    _secure_file(BROWSER_RECOVERY_JOURNAL, maximum=4096)


def _validate_browser_recovery_payload(
    state: dict[str, object], payload: object
) -> dict[str, object]:
    if not isinstance(payload, dict) or set(payload) != {
        "schema",
        "project_id",
        "compose_project",
        "probe",
        "image_a",
        "image_b",
        "browser_pid",
        "active_command_kind",
        "active_command_pid",
    }:
        raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID")
    probe = str(payload.get("probe"))
    browser_pid = payload.get("browser_pid")
    active_kind = payload.get("active_command_kind")
    active_pid = payload.get("active_command_pid")
    expected = _browser_recovery_payload(
        state, probe, browser_pid, active_kind, active_pid
    )
    if (
        payload != expected
        or (
            browser_pid is not None
            and (
                type(browser_pid) is not int
                or browser_pid < 2
                or browser_pid > 2_147_483_647
            )
        )
        or (active_kind is None and active_pid is not None)
        or (active_kind is not None and active_kind not in BROWSER_ACTIVE_COMMANDS)
        or (
            active_pid is not None
            and (
                type(active_pid) is not int
                or active_pid < 2
                or active_pid > 2_147_483_647
            )
        )
        or not PWA_UPDATE_IMAGE_RE.fullmatch(str(payload.get("image_b")))
    ):
        raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID")
    return payload


def _browser_recovery_payload_from_file(
    path: Path, state: dict[str, object]
) -> dict[str, object]:
    _secure_file(path, maximum=4096)
    try:
        payload = json.loads(path.read_text(encoding="ascii"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID") from None
    return _validate_browser_recovery_payload(state, payload)


def _reconcile_browser_recovery_staging(state: dict[str, object]) -> None:
    staging = BROWSER_RECOVERY_JOURNAL.with_name(
        BROWSER_RECOVERY_JOURNAL.name + ".new"
    )
    try:
        info = staging.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID") from None
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_nlink != 1
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_size > 4096
    ):
        raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID")
    try:
        staged_payload = json.loads(staging.read_text(encoding="ascii"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        try:
            staging.unlink()
        except OSError:
            raise LocalError("LOCAL_BROWSER_RECOVERY_CLEANUP_FAILED") from None
        return
    _validate_browser_recovery_payload(state, staged_payload)
    os.replace(staging, BROWSER_RECOVERY_JOURNAL)
    _secure_file(BROWSER_RECOVERY_JOURNAL, maximum=4096)


def _read_browser_recovery_journal(
    state: dict[str, object],
) -> dict[str, object] | None:
    _reconcile_browser_recovery_staging(state)
    if not BROWSER_RECOVERY_JOURNAL.exists():
        return None
    return _browser_recovery_payload_from_file(BROWSER_RECOVERY_JOURNAL, state)


def _replace_browser_recovery_journal(
    state: dict[str, object], body: bytes
) -> None:
    staging = BROWSER_RECOVERY_JOURNAL.with_name(
        BROWSER_RECOVERY_JOURNAL.name + ".new"
    )
    _reconcile_browser_recovery_staging(state)
    if staging.exists():
        raise LocalError("LOCAL_BROWSER_RECOVERY_PENDING")
    _exclusive_write(staging, body)
    os.replace(staging, BROWSER_RECOVERY_JOURNAL)
    _secure_file(BROWSER_RECOVERY_JOURNAL, maximum=4096)


def _update_browser_recovery_pid(
    state: dict[str, object], probe: str, browser_pid: int
) -> None:
    payload = _read_browser_recovery_journal(state)
    if payload is None or payload.get("probe") != probe:
        raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID")
    body = (
        json.dumps(
            _browser_recovery_payload(
                state,
                probe,
                browser_pid,
                payload.get("active_command_kind"),
                payload.get("active_command_pid"),
            ),
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    ).encode("ascii")
    _replace_browser_recovery_journal(state, body)


def _update_browser_recovery_active_command(
    state: dict[str, object],
    probe: str,
    kind: str | None,
    process_pid: int | None,
) -> None:
    payload = _read_browser_recovery_journal(state)
    if (
        payload is None
        or payload.get("probe") != probe
        or (kind is None and process_pid is not None)
        or (kind is not None and kind not in BROWSER_ACTIVE_COMMANDS)
    ):
        raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID")
    body = (
        json.dumps(
            _browser_recovery_payload(
                state,
                probe,
                payload.get("browser_pid"),
                kind,
                process_pid,
            ),
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    ).encode("ascii")
    _replace_browser_recovery_journal(state, body)


def _remove_browser_recovery_journal() -> None:
    staging = BROWSER_RECOVERY_JOURNAL.with_name(
        BROWSER_RECOVERY_JOURNAL.name + ".new"
    )
    if staging.exists():
        raise LocalError("LOCAL_BROWSER_RECOVERY_CLEANUP_FAILED")
    _secure_file(BROWSER_RECOVERY_JOURNAL, maximum=4096)
    try:
        BROWSER_RECOVERY_JOURNAL.unlink()
    except OSError:
        raise LocalError("LOCAL_BROWSER_RECOVERY_CLEANUP_FAILED") from None
    if BROWSER_RECOVERY_JOURNAL.exists():
        raise LocalError("LOCAL_BROWSER_RECOVERY_CLEANUP_FAILED")


def _browser_process_candidate(
    payload: dict[str, object], control_directory: Path
) -> int | None:
    result = _run(
        ["/bin/ps", "-ww", "-axo", "uid=,pid=,pgid=,command="],
        capture=True,
        check=False,
    )
    if result.returncode != 0 or len(result.stdout.encode("utf-8")) > 4 * 1024 * 1024:
        raise LocalError("LOCAL_BROWSER_PROCESS_IDENTITY_INVALID")
    observed_pids: set[int] = set()
    observed_groups: dict[int, list[tuple[int, str]]] = {}
    candidates: list[int] = []
    for line in result.stdout.splitlines():
        match = re.fullmatch(r"\s*(\d+)\s+(\d+)\s+(\d+)\s+(.+)", line)
        if match is None:
            continue
        uid, pid, pgid = (int(match.group(index)) for index in (1, 2, 3))
        command = match.group(4)
        observed_pids.add(pid)
        observed_groups.setdefault(pgid, []).append((uid, command))
        if (
            uid == os.geteuid()
            and pid == pgid
            and pid not in {os.getpid(), os.getpgrp()}
            and str(PWA_BROWSER_RUNNER) in command
            and str(control_directory) in command
            and "--pwa-update-control" in command
        ):
            candidates.append(pid)
    recorded = payload.get("browser_pid")
    if recorded is not None:
        if recorded not in observed_pids:
            members = observed_groups.get(int(recorded), [])
            if not members:
                return None
            profile = str(
                TMP_DIR
                / f"anhuan-engineering-browser-{control_directory.name.removeprefix('pwa-update-')}"
            )
            chrome_markers = ("google chrome", "chromium", "chrome for testing")
            if (
                any(uid != os.geteuid() for uid, _command in members)
                or not any(profile in command for _uid, command in members)
                or any(
                    not any(marker in command.lower() for marker in chrome_markers)
                    for _uid, command in members
                )
            ):
                raise LocalError("LOCAL_BROWSER_PROCESS_IDENTITY_INVALID")
            return int(recorded)
        if candidates != [recorded]:
            raise LocalError("LOCAL_BROWSER_PROCESS_IDENTITY_INVALID")
        return int(recorded)
    if len(candidates) > 1:
        raise LocalError("LOCAL_BROWSER_PROCESS_IDENTITY_INVALID")
    return candidates[0] if candidates else None


def _browser_compose_supervisor_command(
    state: dict[str, object], probe: str, kind: str
) -> tuple[list[str], dict[str, str]]:
    if kind not in BROWSER_ACTIVE_COMMANDS:
        raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
    try:
        source = BROWSER_COMPOSE_SUPERVISOR.resolve(strict=True)
        source_info = source.lstat()
    except OSError:
        raise LocalError("LOCAL_BROWSER_SUPERVISOR_INVALID") from None
    if (
        source != BROWSER_COMPOSE_SUPERVISOR
        or not stat.S_ISREG(source_info.st_mode)
        or stat.S_ISLNK(source_info.st_mode)
        or source_info.st_uid != os.geteuid()
        or source_info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
    ):
        raise LocalError("LOCAL_BROWSER_SUPERVISOR_INVALID")
    image_a = str(state["web_image"])
    image_b = f"{image_a}-pwa-update-{probe}"
    environment = _environment()
    if kind == "build_b":
        environment["LOCAL_PWA_UPDATE_PROBE"] = probe
        environment["LOCAL_WEB_IMAGE"] = image_b
    elif kind == "swap_b":
        environment["LOCAL_WEB_IMAGE"] = image_b
    else:
        environment["LOCAL_WEB_IMAGE"] = image_a
    command = [
        _python(),
        "-B",
        str(source),
        "--kind",
        kind,
        "--probe",
        probe,
        "--project-id",
        str(state["project_id"]),
        "--compose-project",
        str(state["compose_project"]),
        "--state-file",
        str(STATE_FILE),
        "--compose-file",
        str(COMPOSE_FILE),
        "--env-file",
        str(ENV_FILE),
        "--control-directory",
        str(_browser_control_directory(probe)),
        "--docker",
        _docker(),
    ]
    return command, environment


def _browser_supervisor_command_matches(
    command: str, payload: dict[str, object], kind: str
) -> bool:
    probe = str(payload["probe"])
    required = (
        str(BROWSER_COMPOSE_SUPERVISOR),
        f"--kind {kind}",
        f"--probe {probe}",
        f"--project-id {payload['project_id']}",
        f"--compose-project {payload['compose_project']}",
        f"--state-file {STATE_FILE}",
        f"--compose-file {COMPOSE_FILE}",
        f"--env-file {ENV_FILE}",
        f"--control-directory {_browser_control_directory(probe)}",
    )
    return all(marker in command for marker in required)


def _browser_compose_child_matches(
    command: str, payload: dict[str, object], kind: str
) -> bool:
    expected_verb = "build" if kind == "build_b" else "up"
    required = (
        " compose ",
        f"--project-name {payload['compose_project']}",
        f"--env-file {ENV_FILE}",
        f"-f {COMPOSE_FILE}",
        "--profile ops",
    )
    return (
        all(marker in command for marker in required)
        and re.search(rf"\s{expected_verb}(?:\s|$)", command) is not None
        and re.search(r"\sweb(?:\s|$)", command) is not None
    )


def _browser_active_command_candidate(payload: dict[str, object]) -> int | None:
    kind = payload.get("active_command_kind")
    recorded = payload.get("active_command_pid")
    if kind is None:
        return None
    if kind not in BROWSER_ACTIVE_COMMANDS:
        raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
    result = _run(
        ["/bin/ps", "-ww", "-axo", "uid=,pid=,pgid=,sid=,command="],
        capture=True,
        check=False,
    )
    if result.returncode != 0 or len(result.stdout.encode("utf-8")) > 4 * 1024 * 1024:
        raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
    observed_pids: set[int] = set()
    observed_groups: dict[int, list[tuple[int, int, str]]] = {}
    candidates: list[int] = []
    for line in result.stdout.splitlines():
        match = re.fullmatch(
            r"\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(.+)", line
        )
        if match is None:
            continue
        uid, pid, pgid, sid = (
            int(match.group(index)) for index in (1, 2, 3, 4)
        )
        command = match.group(5)
        observed_pids.add(pid)
        observed_groups.setdefault(pgid, []).append((uid, sid, command))
        if (
            uid == os.geteuid()
            and pid == pgid
            and pid == sid
            and pid not in {os.getpid(), os.getpgrp()}
            and _browser_supervisor_command_matches(command, payload, str(kind))
        ):
            candidates.append(pid)

    def trusted_group(pgid: int) -> bool:
        members = observed_groups.get(pgid, [])
        if not members:
            return False
        return all(
            uid == os.geteuid()
            and sid == pgid
            and (
                _browser_supervisor_command_matches(command, payload, str(kind))
                or _browser_compose_child_matches(command, payload, str(kind))
            )
            for uid, sid, command in members
        )

    if recorded is not None:
        if recorded not in observed_pids:
            if trusted_group(int(recorded)):
                return int(recorded)
            if observed_groups.get(int(recorded)):
                raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
            return None
        if candidates != [recorded]:
            raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
        if not trusted_group(int(recorded)):
            raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
        return int(recorded)
    trusted_candidates = sorted(
        pgid for pgid in observed_groups if trusted_group(pgid)
    )
    if len(candidates) > 1 or len(trusted_candidates) > 1:
        raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
    if candidates and trusted_candidates not in ([candidates[0]], []):
        raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
    return (
        candidates[0]
        if candidates
        else trusted_candidates[0]
        if trusted_candidates
        else None
    )


def _complete_recovered_browser_active_command(
    state: dict[str, object], payload: dict[str, object]
) -> None:
    kind = payload.get("active_command_kind")
    if kind is None:
        return
    if kind not in BROWSER_ACTIVE_COMMANDS:
        raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
    deadline = time.monotonic() + 60
    while _browser_active_command_candidate(payload) is not None:
        if time.monotonic() >= deadline:
            raise LocalError("LOCAL_BROWSER_RECOVERY_PENDING")
        time.sleep(0.1)
    receipt = _browser_compose_receipt(
        state,
        str(payload["probe"]),
        expected_kind=str(kind),
        consume=False,
    )
    if receipt is None:
        raise LocalError("LOCAL_BROWSER_COMMAND_COMPLETION_UNPROVEN")
    _update_browser_recovery_active_command(
        state, str(payload["probe"]), None, None
    )
    _browser_compose_receipt(
        state,
        str(payload["probe"]),
        expected_kind=str(kind),
        consume=True,
    )


def _browser_compose(
    state: dict[str, object],
    probe: str,
    kind: str,
    timeout: int,
) -> None:
    if kind not in BROWSER_ACTIVE_COMMANDS:
        raise LocalError("LOCAL_BROWSER_COMMAND_IDENTITY_INVALID")
    existing = _browser_compose_receipt(
        state, probe, expected_kind=None, consume=False
    )
    if existing is not None:
        raise LocalError("LOCAL_BROWSER_RECEIPT_PENDING")
    command, environment = _browser_compose_supervisor_command(
        state, probe, kind
    )
    _update_browser_recovery_active_command(state, probe, kind, None)
    try:
        process = subprocess.Popen(
            command,
            cwd=ROOT,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except (OSError, subprocess.SubprocessError):
        _update_browser_recovery_active_command(state, probe, None, None)
        raise LocalError("LOCAL_COMMAND_FAILED") from None
    try:
        _update_browser_recovery_active_command(state, probe, kind, process.pid)
        try:
            returncode = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            raise LocalError("LOCAL_BROWSER_RECOVERY_PENDING") from None
    except LocalError:
        raise
    except (OSError, subprocess.SubprocessError):
        raise LocalError("LOCAL_COMMAND_FAILED")
    if returncode != 0:
        raise LocalError("LOCAL_BROWSER_SUPERVISOR_FAILED")
    receipt = _browser_compose_receipt(
        state, probe, expected_kind=kind, consume=False
    )
    if receipt is None:
        raise LocalError("LOCAL_BROWSER_COMMAND_COMPLETION_UNPROVEN")
    _update_browser_recovery_active_command(state, probe, None, None)
    consumed = _browser_compose_receipt(
        state, probe, expected_kind=kind, consume=True
    )
    if consumed is None or consumed != receipt:
        raise LocalError("LOCAL_BROWSER_RECEIPT_INVALID")
    if receipt[1] != 0:
        raise LocalError("LOCAL_COMMAND_FAILED")


def _terminate_recovered_browser_process(
    payload: dict[str, object], control_directory: Path
) -> None:
    browser_pid = _browser_process_candidate(payload, control_directory)
    if browser_pid is None:
        return
    try:
        os.killpg(browser_pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_PROCESS_CLEANUP_FAILED") from None
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if _browser_process_candidate(payload, control_directory) is None:
            return
        time.sleep(0.1)
    try:
        os.killpg(browser_pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_PROCESS_CLEANUP_FAILED") from None
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        if _browser_process_candidate(payload, control_directory) is None:
            return
        time.sleep(0.1)
    raise LocalError("LOCAL_BROWSER_PROCESS_CLEANUP_FAILED")


def _read_browser_pwa_plist(path: Path) -> dict[str, object] | None:
    try:
        parent = path.parent.lstat()
    except OSError:
        return None
    if (
        not stat.S_ISDIR(parent.st_mode)
        or stat.S_ISLNK(parent.st_mode)
        or parent.st_uid != os.geteuid()
        or parent.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
    ):
        return None
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError:
        return None
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or before.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
            or not 1 <= before.st_size <= 1024 * 1024
        ):
            return None
        body = bytearray()
        while len(body) <= 1024 * 1024:
            chunk = os.read(descriptor, min(65536, 1024 * 1024 + 1 - len(body)))
            if not chunk:
                break
            body.extend(chunk)
        after = os.fstat(descriptor)
        identity = lambda item: (
            item.st_dev,
            item.st_ino,
            item.st_size,
            item.st_mtime_ns,
            item.st_ctime_ns,
            item.st_mode,
            item.st_uid,
            item.st_nlink,
        )
        if len(body) != before.st_size or identity(before) != identity(after):
            return None
        try:
            document = plistlib.loads(bytes(body))
        except (plistlib.InvalidFileException, ValueError):
            return None
        return document if isinstance(document, dict) else None
    finally:
        os.close(descriptor)


def _cleanup_browser_pwa_shim(
    state: dict[str, object], control_directory: Path
) -> None:
    if sys.platform != "darwin":
        return
    if (
        control_directory.parent != TMP_DIR
        or not re.fullmatch(r"pwa-update-[0-9a-f]{24}", control_directory.name)
    ):
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
    try:
        account = pwd.getpwuid(os.geteuid())
        home = Path(account.pw_dir)
        home_info = home.lstat()
        resolved_home = home.resolve(strict=True)
    except (KeyError, OSError):
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID") from None
    if (
        not home.is_absolute()
        or resolved_home != home
        or not stat.S_ISDIR(home_info.st_mode)
        or stat.S_ISLNK(home_info.st_mode)
        or home_info.st_uid != os.geteuid()
        or home_info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
    ):
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
    applications_parent = home / "Applications"
    try:
        applications_parent_info = applications_parent.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID") from None
    if (
        not stat.S_ISDIR(applications_parent_info.st_mode)
        or stat.S_ISLNK(applications_parent_info.st_mode)
        or applications_parent_info.st_uid != os.geteuid()
        or applications_parent_info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
    ):
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
    applications = applications_parent / "Chrome Apps.localized"
    try:
        applications_info = applications.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID") from None
    if (
        not stat.S_ISDIR(applications_info.st_mode)
        or stat.S_ISLNK(applications_info.st_mode)
        or applications_info.st_uid != os.geteuid()
        or applications_info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
    ):
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
    probe = control_directory.name.removeprefix("pwa-update-")
    expected_profile = TMP_DIR / f"anhuan-engineering-browser-{probe}"
    expected_url = (
        f"http://127.0.0.1:{int(state['web_port'])}/internal-app"
    )
    expected_urls = {expected_url, expected_url + "/"}
    matches: list[tuple[Path, tuple[int, int, int, int], dict[str, object]]] = []
    try:
        entries = list(applications.iterdir())
    except OSError:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID") from None
    if len(entries) > 256:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
    for entry in entries:
        if entry.suffix != ".app":
            continue
        try:
            info = entry.lstat()
        except OSError:
            continue
        if (
            not stat.S_ISDIR(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or info.st_uid != os.geteuid()
            or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
        ):
            continue
        document = _read_browser_pwa_plist(entry / "Contents/Info.plist")
        if document is None:
            continue
        profile = document.get("CrAppModeUserDataDir")
        shortcut_url = document.get("CrAppModeShortcutURL")
        shortcut_id = document.get("CrAppModeShortcutID")
        bundle_id = document.get("CFBundleIdentifier")
        if not isinstance(profile, str) or "\x00" in profile:
            continue
        profile_path = Path(profile)
        if (
            not profile_path.is_absolute()
            or ".." in profile_path.parts
            or str(profile_path) != os.path.normpath(profile)
            or profile_path == expected_profile
            or not profile_path.is_relative_to(expected_profile)
        ):
            continue
        if shortcut_url not in expected_urls:
            raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
        if (
            not isinstance(shortcut_id, str)
            or re.fullmatch(r"[a-p]{32}", shortcut_id) is None
            or profile_path.name != f"_crx_{shortcut_id}"
            or not isinstance(bundle_id, str)
            or not bundle_id.endswith("." + shortcut_id)
        ):
            raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
        matches.append(
            (
                entry,
                (info.st_dev, info.st_ino, info.st_mode, info.st_uid),
                document,
            )
        )
    if len(matches) > 1:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
    if not matches:
        return
    bundle, expected_identity, expected_document = matches[0]
    try:
        current = bundle.lstat()
    except OSError:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID") from None
    if (
        (current.st_dev, current.st_ino, current.st_mode, current.st_uid)
        != expected_identity
        or _read_browser_pwa_plist(bundle / "Contents/Info.plist")
        != expected_document
    ):
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_INVALID")
    try:
        shutil.rmtree(bundle)
    except OSError:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_CLEANUP_FAILED") from None
    try:
        bundle.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_CLEANUP_FAILED") from None
    else:
        raise LocalError("LOCAL_BROWSER_PWA_SHIM_CLEANUP_FAILED")


def _cleanup_browser_profile(control_directory: Path) -> None:
    if (
        control_directory.parent != TMP_DIR
        or not re.fullmatch(r"pwa-update-[0-9a-f]{24}", control_directory.name)
    ):
        raise LocalError("LOCAL_BROWSER_PROFILE_INVALID")
    probe = control_directory.name.removeprefix("pwa-update-")
    profile = TMP_DIR / f"anhuan-engineering-browser-{probe}"
    try:
        info = profile.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_PROFILE_INVALID") from None
    if (
        profile.parent != TMP_DIR
        or not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o700
        or info.st_uid != os.geteuid()
    ):
        raise LocalError("LOCAL_BROWSER_PROFILE_INVALID")
    try:
        shutil.rmtree(profile)
    except OSError:
        raise LocalError("LOCAL_BROWSER_PROFILE_CLEANUP_FAILED") from None
    if profile.exists():
        raise LocalError("LOCAL_BROWSER_PROFILE_CLEANUP_FAILED")


def _recover_browser_recovery_journal(state: dict[str, object]) -> None:
    payload = _read_browser_recovery_journal(state)
    if payload is None:
        return
    probe = str(payload["probe"])
    control_directory = _browser_control_directory(probe)
    _complete_recovered_browser_active_command(state, payload)
    if payload.get("active_command_kind") is not None:
        payload = _read_browser_recovery_journal(state)
        if payload is None:
            raise LocalError("LOCAL_BROWSER_RECOVERY_INVALID")
    _browser_compose_receipt(
        state, probe, expected_kind=None, consume=True
    )
    _terminate_recovered_browser_process(payload, control_directory)
    _assert_resource_labels(state)
    try:
        _assert_web_uses_image(state, str(payload["image_a"]))
    except LocalError:
        _browser_compose(
            state,
            probe,
            "restore_a",
            timeout=240,
        )
        _assert_web_uses_image(state, str(payload["image_a"]))
    observed_id = _inspect_probe_image(state, str(payload["image_b"]), probe)
    if observed_id is not None:
        _run([_docker(), "image", "rm", str(payload["image_b"])], capture=True)
        if _inspect_probe_image(state, str(payload["image_b"]), probe) is not None:
            raise LocalError("LOCAL_PWA_IMAGE_RESIDUAL")
    if _inspect_probe_image(state, str(payload["image_b"]), probe) is not None:
        raise LocalError("LOCAL_PWA_IMAGE_RESIDUAL")
    _cleanup_browser_fault_artifact(control_directory)
    _cleanup_browser_pwa_shim(state, control_directory)
    _cleanup_browser_profile(control_directory)
    if control_directory.exists():
        _cleanup_control_directory(control_directory)
    _assert_web_uses_image(state, str(payload["image_a"]))
    _remove_browser_recovery_journal()


def _inspect_probe_image(
    state: dict[str, object], image: str, probe: str
) -> str | None:
    if not PWA_UPDATE_IMAGE_RE.fullmatch(image) or not re.fullmatch(
        r"[0-9a-f]{24}", probe
    ):
        raise LocalError("LOCAL_PWA_IMAGE_IDENTITY_INVALID")
    result = _run(
        [_docker(), "image", "inspect", image],
        capture=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    try:
        payload = json.loads(result.stdout)
        item = payload[0]
        image_id = item["Id"]
        tags = item["RepoTags"]
        labels = item["Config"]["Labels"]
    except (IndexError, KeyError, TypeError, json.JSONDecodeError):
        raise LocalError("LOCAL_PWA_IMAGE_IDENTITY_INVALID") from None
    if (
        len(payload) != 1
        or not isinstance(image_id, str)
        or not image_id.startswith("sha256:")
        or image not in tags
        or labels.get("io.anhuan.pwa-update-project-id")
        != str(state["project_id"])
        or labels.get("io.anhuan.pwa-update-probe") != probe
    ):
        raise LocalError("LOCAL_PWA_IMAGE_IDENTITY_INVALID")
    return image_id


def _web_container_payload(
    state: dict[str, object], image: str, *, require_healthy: bool
) -> tuple[str, dict[str, object]]:
    image_result = _run(
        [_docker(), "image", "inspect", image], capture=True
    )
    try:
        image_payload = json.loads(image_result.stdout)
        expected_id = image_payload[0]["Id"]
    except (IndexError, KeyError, TypeError, json.JSONDecodeError):
        raise LocalError("LOCAL_PWA_RESTORE_INVALID") from None
    if (
        len(image_payload) != 1
        or not isinstance(expected_id, str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", expected_id) is None
    ):
        raise LocalError("LOCAL_PWA_RESTORE_INVALID")
    container = _compose(state, "ps", "-a", "-q", "web", capture=True)
    container_ids = container.stdout.splitlines()
    if len(container_ids) != 1 or not re.fullmatch(
        r"[0-9a-f]{64}", container_ids[0]
    ):
        raise LocalError("LOCAL_PWA_RESTORE_INVALID")
    inspected = _run(
        [_docker(), "inspect", container_ids[0]], capture=True
    )
    try:
        payload = json.loads(inspected.stdout)[0]
        observed_id = payload["Image"]
        labels = payload["Config"]["Labels"]
        status = payload["State"]["Status"]
        health = payload["State"].get("Health", {}).get("Status", "")
    except (IndexError, KeyError, TypeError, json.JSONDecodeError):
        raise LocalError("LOCAL_PWA_RESTORE_INVALID") from None
    if (
        observed_id != expected_id
        or labels.get("com.docker.compose.project")
        != str(state["compose_project"])
        or labels.get("com.docker.compose.service") != "web"
        or labels.get("io.anhuan.project-id") != str(state["project_id"])
        or labels.get("io.anhuan.scope") != SCOPE
        or str(labels.get("com.docker.compose.oneoff", "False")).lower()
        == "true"
        or (
            require_healthy
            and (status != "running" or health != "healthy")
        )
    ):
        raise LocalError("LOCAL_PWA_RESTORE_INVALID")
    return container_ids[0], payload


def _assert_web_uses_image(state: dict[str, object], image: str) -> None:
    _web_container_payload(state, image, require_healthy=True)


def _terminate_browser_process(process: subprocess.Popen[str] | None) -> None:
    if process is None or process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    except OSError:
        raise LocalError("LOCAL_BROWSER_PROCESS_CLEANUP_FAILED") from None
    try:
        process.wait(timeout=15)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            return
        except OSError:
            raise LocalError("LOCAL_BROWSER_PROCESS_CLEANUP_FAILED") from None
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            raise LocalError("LOCAL_BROWSER_PROCESS_CLEANUP_FAILED") from None


def _browser_summary_contract(
    stage: str,
) -> tuple[dict[str, int | str], str | None, int]:
    if stage not in BROWSER_STAGES:
        raise LocalError("LOCAL_BROWSER_STAGE_INVALID")
    business: dict[str, int | str] = {
        "identities_authenticated": 3,
        "admin_pages_visited": 17,
        "admin_api_non_2xx": 0,
        "consultant_pages_visited": 2,
        "enterprise_pages_visited": 2,
        "role_api_non_2xx": 0,
        "role_allowed_action_ui_checks": 2,
        "cross_tenant_404_ui_count": 1,
        "illegal_state_409_ui_count": 1,
        "tenant_header_changes": 1,
        "tenant_state_clears": 1,
    }
    faults: dict[str, int | str] = {
        "expected_fault_api_non_2xx": 1,
        "service_unavailable_503_ui_count": 1,
        "service_unavailable_503_ui_status": "PASSED",
        "clamd_unavailable_ui_count": 1,
        "clamd_recovery_ui_count": 1,
    }
    pwa_runtime: dict[str, int | str] = {
        "pwa_registrations": 1,
        "pwa_controlled_clients": 1,
        "pwa_owned_caches": 2,
        "pwa_sensitive_cache_entries": 0,
        "pwa_offline_shell": 1,
    }
    pwa_update: dict[str, int | str] = {
        **pwa_runtime,
        "pwa_waiting_updates": 1,
        "pwa_controller_changes": 1,
        "pwa_old_caches_removed": 2,
        "pwa_new_caches": 2,
        "pwa_sentinel_caches_preserved": 1,
        "pwa_login_states_preserved": 1,
        "pwa_update_status": "PWA_WAITING_UPDATE_PASSED",
    }
    pwa_os: dict[str, int | str] = {
        **pwa_runtime,
        "pwa_installability_errors": 0,
        "pwa_installations": 0,
        "pwa_os_offline_reopens": 0,
        "pwa_os_online_launches": 0,
        "pwa_os_shim_residuals": 0,
        "pwa_os_shims_created": 0,
        "pwa_os_install_status": "PWA_OS_INSTALL_NOT_TESTED",
        "pwa_os_uninstall_probe": 0,
        "pwa_os_uninstallations": 0,
    }
    if stage == "business":
        return {**business, "stage": "business"}, "admin_api_responses", 17
    if stage == "faults":
        return {**faults, "stage": "faults"}, None, 0
    if stage == "pwa-update":
        return {
            **pwa_update,
            "pwa_apply_clicks": 1,
            "stage": "pwa-update",
        }, None, 0
    if stage == "pwa-os":
        return {**pwa_os, "stage": "pwa-os"}, None, 0
    return (
        {
            **business,
            **faults,
            **pwa_update,
            **pwa_os,
            "expected_fault_api_non_2xx": 3,
            "pwa_apply_clicks": 1,
            "stage": "all",
        },
        "admin_api_responses",
        17,
    )


def _validate_browser_summary(
    stdout: str, returncode: int, *, stage: str = "all"
) -> dict[str, object]:
    lines = stdout.splitlines()
    if returncode != 0:
        raise LocalError("LOCAL_BROWSER_EXIT_WITHOUT_REASON")
    if stage not in BROWSER_STAGE_TAGS:
        raise LocalError("LOCAL_BROWSER_STAGE_INVALID")
    if len(lines) != 2 or lines[1] != BROWSER_STAGE_TAGS[stage]:
        raise LocalError("LOCAL_BROWSER_OUTPUT_SHAPE_INVALID")
    try:
        summary = json.loads(lines[0])
    except json.JSONDecodeError:
        raise LocalError("LOCAL_BROWSER_OUTPUT_INVALID") from None
    expected_exact, ranged_key, ranged_minimum = _browser_summary_contract(stage)
    expected_keys = set(expected_exact)
    if ranged_key is not None:
        expected_keys.add(ranged_key)
    if (
        not isinstance(summary, dict)
        or set(summary) != expected_keys
        or any(summary.get(key) != value for key, value in expected_exact.items())
        or (
            ranged_key is not None
            and (
                type(summary.get(ranged_key)) is not int
                or int(summary[ranged_key]) < ranged_minimum
            )
        )
    ):
        raise LocalError("LOCAL_BROWSER_OUTPUT_INVALID")
    return summary


def _orchestrate_browser_dependency_fault(
    state: dict[str, object],
    control_directory: Path,
    browser: subprocess.Popen[str],
    *,
    service: str,
    ready_signal: str,
    stopped_signal: str,
    observed_signal: str,
    restored_signal: str,
) -> None:
    if service not in {"minio", "clamd"}:
        raise LocalError("LOCAL_REVERSE_SERVICE_INVALID")
    _wait_for_control_signal(control_directory, ready_signal, browser)
    container_id, _payload = _service_container_payload(
        state, service, require_healthy=True
    )
    _write_reverse_journal(
        {
            "kind": "dependency",
            "project_id": state["project_id"],
            "compose_project": state["compose_project"],
            "service": service,
            "container_id": container_id,
        }
    )
    _run(
        [_docker(), "stop", "--time", "30", container_id],
        capture=True,
        timeout=45,
    )
    observed_id, observed = _service_container_payload(
        state, service, require_healthy=False
    )
    if observed_id != container_id or observed.get("State", {}).get("Running") is not False:
        raise LocalError("LOCAL_BROWSER_DEPENDENCY_STOP_FAILED")
    _exclusive_write(control_directory / stopped_signal, PWA_CONTROL_SIGNAL)
    _wait_for_control_signal(control_directory, observed_signal, browser)
    _recover_reverse_journal(state)
    _exclusive_write(control_directory / restored_signal, PWA_CONTROL_SIGNAL)


def _orchestrate_browser_pwa_offline_reopen(
    state: dict[str, object],
    control_directory: Path,
    browser: subprocess.Popen[str],
    *,
    image_b: str,
) -> None:
    _wait_for_control_signal(
        control_directory, PWA_OS_OFFLINE_READY, browser
    )
    container_id, _payload = _web_container_payload(
        state, image_b, require_healthy=True
    )
    _run(
        [_docker(), "stop", "--time", "30", container_id],
        capture=True,
        timeout=45,
    )
    observed_id, observed = _web_container_payload(
        state, image_b, require_healthy=False
    )
    if (
        observed_id != container_id
        or observed.get("State", {}).get("Running") is not False
        or observed.get("State", {}).get("Status") != "exited"
    ):
        raise LocalError("LOCAL_BROWSER_PWA_WEB_STOP_FAILED")
    _exclusive_write(
        control_directory / PWA_OS_WEB_STOPPED, PWA_CONTROL_SIGNAL
    )
    _wait_for_control_signal(
        control_directory, PWA_OS_OFFLINE_OBSERVED, browser
    )
    _run([_docker(), "start", container_id], capture=True, timeout=45)
    deadline = time.monotonic() + 180
    while True:
        restored_id, restored = _web_container_payload(
            state, image_b, require_healthy=False
        )
        restored_state = restored.get("State", {})
        if (
            restored_id == container_id
            and restored_state.get("Status") == "running"
            and restored_state.get("Health", {}).get("Status") == "healthy"
        ):
            break
        if time.monotonic() >= deadline:
            raise LocalError("LOCAL_BROWSER_PWA_WEB_RESTORE_FAILED")
        time.sleep(0.25)
    _assert_web_uses_image(state, image_b)
    _exclusive_write(
        control_directory / PWA_OS_WEB_RESTORED, PWA_CONTROL_SIGNAL
    )


def _browser_verify(state: dict[str, object], *, stage: str = "all") -> None:
    if stage not in BROWSER_STAGES:
        raise LocalError("LOCAL_BROWSER_STAGE_INVALID")
    if stage == "pwa-os":
        raise LocalError(
            "LOCAL_PWA_OS_BLOCKED_BY_BROWSER_AUTOMATION_BOUNDARY"
        )
    _health(state, as_json=False, silent=True)
    _directory(TMP_DIR)
    probe = secrets.token_hex(12)
    control_directory = _browser_control_directory(probe)
    image_a = str(state["web_image"])
    image_b = f"{image_a}-pwa-update-{probe}"
    browser: subprocess.Popen[str] | None = None
    probe_image_id: str | None = None
    summary: dict[str, object] | None = None
    primary_error: LocalError | None = None
    cleanup_error: LocalError | None = None
    _write_browser_recovery_journal(state, probe)
    try:
        try:
            control_directory.mkdir(mode=0o700)
            _directory(control_directory)
        except OSError:
            raise LocalError("LOCAL_PWA_CONTROL_DIRECTORY_INVALID") from None
        if stage in {"all", "pwa-update"}:
            if _inspect_probe_image(state, image_b, probe) is not None:
                raise LocalError("LOCAL_PWA_IMAGE_ALREADY_EXISTS")
            _browser_compose(
                state,
                probe,
                "build_b",
                timeout=1800,
            )
            probe_image_id = _inspect_probe_image(state, image_b, probe)
            if probe_image_id is None:
                raise LocalError("LOCAL_PWA_IMAGE_BUILD_MISSING")
        browser_command = [
            _node(),
            str(PWA_BROWSER_RUNNER),
            f"http://127.0.0.1:{int(state['web_port'])}",
            str(SECRETS_DIR),
            "--stage",
            stage,
            "--pwa-update-control",
            str(control_directory),
        ]
        browser = subprocess.Popen(
            browser_command,
            cwd=ROOT,
            env=_environment(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        _update_browser_recovery_pid(state, probe, browser.pid)
        if stage in {"all", "faults"}:
            _orchestrate_browser_dependency_fault(
                state,
                control_directory,
                browser,
                service="minio",
                ready_signal=MINIO_FAULT_READY,
                stopped_signal=MINIO_STOPPED,
                observed_signal=MINIO_503_OBSERVED,
                restored_signal=MINIO_RESTORED,
            )
            _orchestrate_browser_dependency_fault(
                state,
                control_directory,
                browser,
                service="clamd",
                ready_signal=CLAMD_FAULT_READY,
                stopped_signal=CLAMD_STOPPED,
                observed_signal=CLAMD_UNAVAILABLE_OBSERVED,
                restored_signal=CLAMD_RESTORED,
            )
        if stage in {"all", "pwa-update"}:
            _wait_for_control_signal(
                control_directory, PWA_BROWSER_READY, browser
            )
            _browser_compose(
                state,
                probe,
                "swap_b",
                timeout=240,
            )
            _assert_web_uses_image(state, image_b)
            _exclusive_write(
                control_directory / PWA_IMAGE_READY, PWA_CONTROL_SIGNAL
            )
        try:
            stdout, browser_stderr = browser.communicate(timeout=600)
        except subprocess.TimeoutExpired:
            raise LocalError("LOCAL_BROWSER_VERIFY_TIMEOUT") from None
        browser_failure = _browser_failure(browser_stderr)
        if browser_failure is not None:
            raise browser_failure
        summary = _validate_browser_summary(
            stdout, int(browser.returncode), stage=stage
        )
    except LocalError as error:
        primary_error = error
    except (OSError, subprocess.SubprocessError):
        primary_error = LocalError("LOCAL_BROWSER_VERIFY_FAILED")
    finally:
        cleanup_failures: list[LocalError] = []
        try:
            _terminate_browser_process(browser)
        except LocalError as error:
            cleanup_failures.append(error)
        try:
            _recover_reverse_journal(state)
        except LocalError as error:
            cleanup_failures.append(error)
        try:
            _recover_browser_recovery_journal(state)
            _health(state, as_json=False, silent=True)
        except LocalError as error:
            cleanup_failures.append(error)
        if cleanup_failures:
            cleanup_error = cleanup_failures[0]
    if primary_error is not None:
        raise primary_error
    if cleanup_error is not None:
        raise cleanup_error
    if summary is None:
        raise LocalError("LOCAL_BROWSER_OUTPUT_INVALID")
    log_metrics, log_tag = _runtime_log_metrics(state)
    print(json.dumps(summary, sort_keys=True, separators=(",", ":")))
    print(BROWSER_STAGE_TAGS[stage])
    print(log_metrics)
    print(log_tag)


def _sync_secrets(
    state: dict[str, object], *, capture: bool = False
) -> None:
    _compose(
        state,
        "run",
        "--rm",
        "--no-deps",
        "secret-init",
        capture=capture,
    )


def _migrate(state: dict[str, object]) -> None:
    _sync_secrets(state)
    _compose(state, "build", "migrator", timeout=1200)
    _compose(
        state,
        "up",
        "-d",
        "--wait",
        "--wait-timeout",
        "180",
        "postgres",
        timeout=240,
    )
    _compose(state, "run", "--rm", "migrator", timeout=600)


def _seed(state: dict[str, object]) -> None:
    _migrate(state)
    _compose(state, "run", "--rm", "seed", timeout=180)


def _read_secret_for_log_check(name: str) -> bytes:
    if name not in ALL_SECRET_NAMES:
        raise LocalError("LOCAL_LOG_SECRET_NAME_INVALID")
    path = SECRETS_DIR / name
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError:
        raise LocalError("LOCAL_LOG_SECRET_INVALID") from None
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_size < 1
            or before.st_size > 16384
        ):
            raise LocalError("LOCAL_LOG_SECRET_INVALID")
        body = os.read(descriptor, before.st_size + 1)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    identity = lambda info: (
        info.st_dev,
        info.st_ino,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )
    if len(body) != before.st_size or identity(before) != identity(after):
        raise LocalError("LOCAL_LOG_SECRET_INVALID")
    if name != "f0i_key":
        try:
            body.decode("ascii")
        except UnicodeDecodeError:
            raise LocalError("LOCAL_LOG_SECRET_INVALID") from None
        if len(body) < 8 or body != body.strip():
            raise LocalError("LOCAL_LOG_SECRET_INVALID")
    return body


def _docker_logs_bounded(container_id: str) -> bytes:
    if not re.fullmatch(r"[0-9a-f]{64}", container_id):
        raise LocalError("LOCAL_LOG_CONTAINER_IDENTITY_INVALID")
    try:
        process = subprocess.Popen(
            [_docker(), "logs", container_id],
            cwd=ROOT,
            env=_environment(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=False,
        )
    except OSError:
        raise LocalError("LOCAL_LOG_READ_FAILED") from None
    if process.stdout is None or process.stderr is None:
        process.kill()
        process.wait()
        raise LocalError("LOCAL_LOG_READ_FAILED")
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    selector.register(process.stderr, selectors.EVENT_READ)
    body = bytearray()
    deadline = time.monotonic() + 30.0
    try:
        while selector.get_map():
            if time.monotonic() >= deadline:
                raise LocalError("LOCAL_LOG_READ_TIMEOUT")
            for key, _events in selector.select(timeout=0.25):
                try:
                    chunk = os.read(key.fd, 65536)
                except OSError:
                    raise LocalError("LOCAL_LOG_READ_FAILED") from None
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                body.extend(chunk)
                if len(body) > local_log_verify.MAX_SERVICE_LOG_BYTES:
                    raise LocalError("LOCAL_LOG_SIZE_LIMIT")
        try:
            returncode = process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            raise LocalError("LOCAL_LOG_READ_TIMEOUT") from None
    except LocalError:
        process.kill()
        process.wait()
        raise
    finally:
        selector.close()
        process.stdout.close()
        process.stderr.close()
    if returncode != 0:
        raise LocalError("LOCAL_LOG_READ_FAILED")
    return bytes(body)


def _scan_files_for_exact_secrets(
    paths: list[Path],
    secret_values: tuple[bytes, ...],
    *,
    maximum_total_bytes: int,
    maximum_file_bytes: int,
) -> tuple[int, int]:
    if not paths or not secret_values:
        return len(paths), 0
    maximum_secret = max(map(len, secret_values))
    total_bytes = 0
    leak_count = 0
    for path in paths:
        flags = os.O_RDONLY
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        try:
            descriptor = os.open(path, flags)
        except OSError:
            raise LocalError("LOCAL_LOG_FILE_SCAN_INVALID") from None
        try:
            before = os.fstat(descriptor)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_uid != os.geteuid()
                or before.st_nlink != 1
                or before.st_size > maximum_file_bytes
            ):
                raise LocalError("LOCAL_LOG_FILE_SCAN_INVALID")
            total_bytes += before.st_size
            if total_bytes > maximum_total_bytes:
                raise LocalError("LOCAL_LOG_FILE_SCAN_SIZE_LIMIT")
            matched: set[int] = set()
            suffix = b""
            while True:
                chunk = os.read(descriptor, 65536)
                if not chunk:
                    break
                window = suffix + chunk
                for index, secret in enumerate(secret_values):
                    if index not in matched and secret in window:
                        matched.add(index)
                suffix = window[-(maximum_secret - 1) :] if maximum_secret > 1 else b""
            after = os.fstat(descriptor)
        except OSError:
            raise LocalError("LOCAL_LOG_FILE_SCAN_INVALID") from None
        finally:
            os.close(descriptor)
        identity = lambda info: (
            info.st_dev,
            info.st_ino,
            info.st_size,
            info.st_mtime_ns,
            info.st_ctime_ns,
        )
        if identity(before) != identity(after):
            raise LocalError("LOCAL_LOG_FILE_SCAN_CHANGED")
        leak_count += len(matched)
    return len(paths), leak_count


def _repository_files_for_log_check() -> list[Path]:
    result = _run(
        [_git(), "-C", str(ROOT), "ls-files", "-co", "--exclude-standard", "-z"],
        capture=True,
        timeout=30,
    )
    relative_paths = [entry for entry in result.stdout.split("\0") if entry]
    if not relative_paths or len(relative_paths) != len(set(relative_paths)):
        raise LocalError("LOCAL_LOG_REPOSITORY_SCAN_INVALID")
    files: list[Path] = []
    for relative in relative_paths:
        candidate = Path(relative)
        if candidate.is_absolute() or ".." in candidate.parts:
            raise LocalError("LOCAL_LOG_REPOSITORY_SCAN_INVALID")
        path = ROOT / candidate
        try:
            info = path.lstat()
        except OSError:
            raise LocalError("LOCAL_LOG_REPOSITORY_SCAN_INVALID") from None
        if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
            raise LocalError("LOCAL_LOG_REPOSITORY_SCAN_INVALID")
        files.append(path)
    return files


def _backup_files_for_log_check(state: dict[str, object]) -> list[Path]:
    backups = _backup_catalog()
    if not backups:
        return []
    files: list[Path] = []
    # Scan every recognized private backup, including v1 packages that predate
    # the current restore identity contract.  Restore still accepts only the
    # current schema; the log gate's job here is narrower and must not omit an
    # older package that could contain a copied runtime secret.
    for selected in (backups[name] for name in sorted(backups)):
        for directory, directory_names, file_names in os.walk(
            selected, topdown=True, followlinks=False
        ):
            directory_names.sort()
            file_names.sort()
            directory_path = Path(directory)
            try:
                directory_info = directory_path.lstat()
            except OSError:
                raise LocalError("LOCAL_LOG_BACKUP_SCAN_INVALID") from None
            if (
                not stat.S_ISDIR(directory_info.st_mode)
                or stat.S_ISLNK(directory_info.st_mode)
                or directory_info.st_uid != os.geteuid()
                or stat.S_IMODE(directory_info.st_mode) != 0o700
            ):
                raise LocalError("LOCAL_LOG_BACKUP_SCAN_INVALID")
            for name in file_names:
                path = directory_path / name
                try:
                    info = path.lstat()
                except OSError:
                    raise LocalError("LOCAL_LOG_BACKUP_SCAN_INVALID") from None
                if (
                    not stat.S_ISREG(info.st_mode)
                    or stat.S_ISLNK(info.st_mode)
                    or info.st_uid != os.geteuid()
                    or stat.S_IMODE(info.st_mode) != 0o600
                ):
                    raise LocalError("LOCAL_LOG_BACKUP_SCAN_INVALID")
                files.append(path)
    return files


def _runtime_log_metrics(state: dict[str, object]) -> tuple[str, str]:
    _assert_resource_labels(state)
    expected_project = str(state["compose_project"])
    expected_project_id = str(state["project_id"])
    containers: dict[str, str] = {}
    for container_id in _resource_ids("ps", expected_project):
        result = _run([_docker(), "inspect", container_id], capture=True)
        try:
            payload = json.loads(result.stdout)[0]
            labels = payload["Config"]["Labels"]
            service = str(labels["com.docker.compose.service"])
            oneoff = str(labels.get("com.docker.compose.oneoff", "False"))
            running = bool(payload["State"]["Running"])
        except (IndexError, KeyError, TypeError, json.JSONDecodeError):
            raise LocalError("LOCAL_LOG_CONTAINER_IDENTITY_INVALID") from None
        if oneoff.lower() == "true":
            continue
        if (
            service not in local_log_verify.CORE_SERVICES
            or service in containers
            or not running
            or labels.get("com.docker.compose.project") != expected_project
            or labels.get("io.anhuan.scope") != SCOPE
            or labels.get("io.anhuan.project-id") != expected_project_id
        ):
            raise LocalError("LOCAL_LOG_CONTAINER_IDENTITY_INVALID")
        containers[service] = container_id
    if set(containers) != local_log_verify.CORE_SERVICES:
        raise LocalError("LOCAL_LOG_CONTAINER_SET_INVALID")

    service_logs: dict[str, bytes] = {}
    for service in sorted(containers):
        service_logs[service] = _docker_logs_bounded(containers[service])
    if sum(map(len, service_logs.values())) > local_log_verify.MAX_TOTAL_LOG_BYTES:
        raise LocalError("LOCAL_LOG_SIZE_LIMIT")
    secret_values = tuple(
        _read_secret_for_log_check(name) for name in ALL_SECRET_NAMES
    )
    repository_count, repository_leaks = _scan_files_for_exact_secrets(
        _repository_files_for_log_check(),
        secret_values,
        maximum_total_bytes=128 * 1024 * 1024,
        maximum_file_bytes=32 * 1024 * 1024,
    )
    backup_count, backup_leaks = _scan_files_for_exact_secrets(
        _backup_files_for_log_check(state),
        secret_values,
        maximum_total_bytes=512 * 1024 * 1024,
        maximum_file_bytes=512 * 1024 * 1024,
    )
    try:
        counts = local_log_verify.verify_runtime_logs(
            service_logs,
            secret_values=secret_values,
            repository_scanned_file_count=repository_count,
            repository_secret_leak_count=repository_leaks,
            backup_scanned_file_count=backup_count,
            backup_secret_leak_count=backup_leaks,
        )
        return local_log_verify.render_success(counts)
    except local_log_verify.LogVerificationError as error:
        reason = str(error)
        if not re.fullmatch(r"LOCAL_LOG_[A-Z0-9_]{1,64}", reason):
            reason = "LOCAL_LOG_BOUNDARY_FAILED"
        raise LocalError(reason) from None


def _targeted_test(state: dict[str, object]) -> None:
    # Python contracts run in the production-equivalent runtime image.  The
    # pinned Node/npm/typecheck path is exercised by the real Web image build;
    # it is intentionally not borrowed from the developer's HOME/node_modules.
    _compose(state, "build", "verifier", "web", capture=True, timeout=1800)
    _compose(state, "build", "targeted-tests", capture=True, timeout=1800)
    result = _compose_contract(state, "targeted-tests", timeout=180)
    lines = result.stdout.splitlines()
    try:
        metrics = json.loads(lines[0])
    except (IndexError, json.JSONDecodeError):
        raise LocalError("LOCAL_TARGETED_TESTS_OUTPUT_INVALID") from None
    if (
        len(lines) != 2
        or lines[1] != "LOCAL_TARGETED_TESTS_OK"
        or not isinstance(metrics, dict)
        or set(metrics) != {"errors", "failures", "skipped", "tests"}
        or any(type(value) is not int for value in metrics.values())
        or metrics["errors"] != 0
        or metrics["failures"] != 0
        or metrics["skipped"] != 0
        or metrics["tests"] < 137
    ):
        raise LocalError("LOCAL_TARGETED_TESTS_OUTPUT_INVALID")
    metrics["web_builds"] = 1
    print(json.dumps(metrics, sort_keys=True, separators=(",", ":")))
    print("LOCAL_TARGETED_TESTS_OK")


def _verify(state: dict[str, object]) -> None:
    expected_atomicity = {
        "normal_migration_head_count": 2,
        "rollback_business_relation_count": 0,
        "rollback_business_routine_count": 0,
        "rollback_f0_schema_count": 0,
        "rollback_f1_schema_count": 0,
        "rollback_version_table_count": 0,
        "scratch_database_residual_count": 0,
    }
    expected_business = {
        "application_engine_restart_count": 1,
        "audit_gap_count": 0,
        "cross_tenant_api_leak_count": 0,
        "external_call_count": 0,
        "illegal_state_transition_409_count": 1,
        "illegal_transition_audit_delta_count": 0,
        "illegal_transition_business_delta_count": 0,
        "illegal_transition_notification_delta_count": 0,
        "illegal_transition_timeline_delta_count": 0,
        "notification_failure_count": 0,
        "oidc_dependency_override_count": 4,
        "p2_api_chain_count": 1,
        "p4_api_chain_count": 1,
        "p5_api_chain_count": 1,
        "p6_api_chain_count": 1,
        "p7_api_chain_count": 1,
        "post_restart_business_read_count": 5,
        "post_restart_cross_tenant_detail_leak_count": 0,
        "post_restart_cross_tenant_list_leak_count": 0,
        "rls_select_leak_count": 0,
        "rls_write_leak_count": 0,
        "scratch_database_count": 1,
        "scratch_database_residual_count": 0,
        "source_business_row_delta_count": 0,
        "timeline_gap_count": 0,
    }
    expected_ingestion = {
        "audit_action_count": 5,
        "bucket_residual_count": 0,
        "clean_scan_count": 1,
        "cross_tenant_api_visible_count": 0,
        "cross_tenant_rls_visible_count": 0,
        "idempotent_upload_recovery_count": 1,
        "minio_write_failure_count": 1,
        "object_residual_count": 0,
        "object_sha_mismatch_count": 0,
        "preview_unit_count": 1,
        "released_object_count": 1,
        "scanner_retry_recovery_count": 1,
        "scanner_unavailable_count": 1,
        "scratch_database_residual_count": 0,
        "scratch_migration_head_count": 2,
        "source_database_mutation_count": 0,
        "uploaded_version_count": 1,
    }
    _sync_secrets(state)
    _compose(
        state,
        "build",
        "verifier",
        timeout=1200,
    )
    _compose(
        state,
        "up",
        "-d",
        "--wait",
        "--wait-timeout",
        "360",
        "postgres",
        "minio",
        "clamd",
        timeout=420,
    )
    result = _compose_contract(state, "verifier", timeout=180)
    lines = result.stdout.splitlines()
    try:
        verification_metrics = json.loads(lines[0])
    except (IndexError, json.JSONDecodeError):
        raise LocalError("LOCAL_VERIFY_OUTPUT_INVALID") from None
    if (
        len(lines) != 2
        or lines[1] != "LOCAL_VERIFY_OK"
        or verification_metrics != EXPECTED_VERIFICATION_METRICS
        or any(type(value) is not int for value in verification_metrics.values())
    ):
        raise LocalError("LOCAL_VERIFY_OUTPUT_INVALID")

    atomicity = _compose_contract(
        state, "migration-atomicity", timeout=600
    )
    atomicity_lines = atomicity.stdout.splitlines()
    try:
        atomicity_metrics = json.loads(atomicity_lines[0])
    except (IndexError, json.JSONDecodeError):
        raise LocalError("LOCAL_ATOMICITY_OUTPUT_INVALID") from None
    if (
        len(atomicity_lines) != 2
        or atomicity_lines[1] != "LOCAL_MIGRATION_ATOMICITY_OK"
        or atomicity_metrics != expected_atomicity
        or any(type(value) is not int for value in atomicity_metrics.values())
    ):
        raise LocalError("LOCAL_ATOMICITY_OUTPUT_INVALID")

    business = _compose_contract(state, "business-verifier", timeout=900)
    business_lines = business.stdout.splitlines()
    try:
        business_metrics = json.loads(business_lines[0])
    except (IndexError, json.JSONDecodeError):
        raise LocalError("LOCAL_BUSINESS_OUTPUT_INVALID") from None
    if (
        len(business_lines) != 2
        or business_lines[1] != "LOCAL_BUSINESS_VERIFY_OK"
        or business_metrics != expected_business
        or any(type(value) is not int for value in business_metrics.values())
    ):
        raise LocalError("LOCAL_BUSINESS_OUTPUT_INVALID")

    ingestion = _compose_contract(
        state, "ingestion-verifier", timeout=900
    )
    ingestion_lines = ingestion.stdout.splitlines()
    try:
        ingestion_metrics = json.loads(ingestion_lines[0])
    except (IndexError, json.JSONDecodeError):
        raise LocalError("LOCAL_INGESTION_OUTPUT_INVALID") from None
    if (
        len(ingestion_lines) != 2
        or ingestion_lines[1] != "LOCAL_INGESTION_VERIFY_OK"
        or ingestion_metrics != expected_ingestion
        or any(type(value) is not int for value in ingestion_metrics.values())
    ):
        raise LocalError("LOCAL_INGESTION_OUTPUT_INVALID")

    log_metrics, log_tag = _runtime_log_metrics(state)

    print(json.dumps(verification_metrics, sort_keys=True, separators=(",", ":")))
    print("LOCAL_VERIFY_OK")
    print(json.dumps(atomicity_metrics, sort_keys=True, separators=(",", ":")))
    print("LOCAL_MIGRATION_ATOMICITY_OK")
    print(json.dumps(business_metrics, sort_keys=True, separators=(",", ":")))
    print("LOCAL_BUSINESS_VERIFY_OK")
    print(json.dumps(ingestion_metrics, sort_keys=True, separators=(",", ":")))
    print("LOCAL_INGESTION_VERIFY_OK")
    print(log_metrics)
    print(log_tag)


def _start(
    state: dict[str, object], *, capture: bool = False, announce: bool = True
) -> None:
    _sync_secrets(state, capture=capture)
    _compose(
        state,
        "build",
        "migrator",
        "web",
        capture=capture,
        timeout=1800,
    )
    _compose(
        state,
        "up",
        "-d",
        "--force-recreate",
        "--wait",
        "--wait-timeout",
        "360",
        "postgres",
        "keycloak",
        "minio",
        "redis",
        "clamd",
        capture=capture,
        timeout=420,
    )
    _compose(
        state,
        "run",
        "--rm",
        "migrator",
        capture=capture,
        timeout=600,
    )
    _compose(
        state, "run", "--rm", "seed", capture=capture, timeout=180
    )
    _compose(
        state,
        "run",
        "--rm",
        "keycloak-provisioner",
        capture=capture,
        timeout=180,
    )
    _compose(
        state,
        "up",
        "-d",
        "--force-recreate",
        "--wait",
        "--wait-timeout",
        "180",
        "api",
        "worker",
        "dispatcher",
        "web",
        capture=capture,
        timeout=240,
    )
    _health(state, as_json=False, silent=not announce)


def _resource_ids(kind: str, project: str) -> list[str]:
    if kind == "ps":
        command = [_docker(), "ps", "-a", "-q", "--no-trunc"]
    else:
        command = [_docker(), kind, "ls", "-q"]
    command.extend(["--filter", f"label=com.docker.compose.project={project}"])
    result = _run(command, capture=True)
    return [line for line in result.stdout.splitlines() if line]


def _assert_resource_labels(state: dict[str, object]) -> None:
    expected_project = str(state["compose_project"])
    expected_id = str(state["project_id"])
    for list_kind in ("ps", "volume", "network"):
        for resource_id in _resource_ids(list_kind, expected_project):
            inspect = (
                [_docker(), "inspect", resource_id]
                if list_kind == "ps"
                else [_docker(), list_kind, "inspect", resource_id]
            )
            result = _run(
                inspect,
                capture=True,
            )
            try:
                payload = json.loads(result.stdout)[0]
                labels = payload.get("Config", {}).get("Labels", {})
                if list_kind != "ps":
                    labels = payload.get("Labels", {})
            except (IndexError, AttributeError, json.JSONDecodeError):
                raise LocalError("LOCAL_RESOURCE_IDENTITY_INVALID") from None
            if (
                labels.get("com.docker.compose.project") != expected_project
                or labels.get("io.anhuan.scope") != SCOPE
                or labels.get("io.anhuan.project-id") != expected_id
            ):
                raise LocalError("LOCAL_RESOURCE_IDENTITY_MISMATCH")


def _http_status(url: str) -> bool:
    try:
        request = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(request, timeout=5) as response:
            return response.status == 200
    except (OSError, urllib.error.URLError):
        return False


def _api_readiness_ready(url: str) -> bool:
    observation = _api_readiness_observation(url)
    return bool(
        observation is not None
        and observation[0] == 200
        and observation[1].get("status") == "ready"
        and observation[1].get("components")
        == {
            "clamd": True,
            "database": True,
            "minio": True,
            "oidc": True,
            "redis": True,
        }
    )


def _api_readiness_observation(
    url: str, *, timeout_seconds: float = 5
) -> tuple[int, dict[str, object]] | None:
    try:
        request = urllib.request.Request(url, method="GET")
        try:
            response = urllib.request.urlopen(request, timeout=timeout_seconds)
        except urllib.error.HTTPError as error:
            response = error
        try:
            body = response.read(4097)
            cache_control = response.headers.get("Cache-Control", "")
            status_code = int(response.status)
        finally:
            response.close()
        payload = json.loads(body)
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        return None
    components = payload.get("components") if isinstance(payload, dict) else None
    if (
        status_code not in {200, 503}
        or len(body) > 4096
        or "no-store" not in cache_control.lower()
        or not isinstance(payload, dict)
        or set(payload) != {"status", "components"}
        or payload.get("status") not in {"ready", "unavailable"}
        or not isinstance(components, dict)
        or set(components) != {"clamd", "database", "minio", "oidc", "redis"}
        or any(type(value) is not bool for value in components.values())
        or (status_code == 200) != all(components.values())
        or (payload.get("status") == "ready") != all(components.values())
    ):
        return None
    return status_code, payload


def _catalog_ready(state: dict[str, object]) -> bool:
    try:
        result = _compose_contract(state, "verifier", timeout=180)
        lines = result.stdout.splitlines()
        metrics = json.loads(lines[0])
    except (IndexError, json.JSONDecodeError, LocalError):
        return False
    return bool(
        len(lines) == 2
        and lines[1] == "LOCAL_VERIFY_OK"
        and metrics == EXPECTED_VERIFICATION_METRICS
        and all(type(value) is int for value in metrics.values())
    )


def _core_containers_ready(state: dict[str, object]) -> bool:
    expected = {
        "api",
        "clamd",
        "dispatcher",
        "keycloak",
        "minio",
        "postgres",
        "redis",
        "web",
        "worker",
    }
    observed: dict[str, tuple[str, str]] = {}
    project = str(state["compose_project"])
    for container_id in _resource_ids("ps", project):
        result = _run([_docker(), "inspect", container_id], capture=True)
        try:
            payload = json.loads(result.stdout)[0]
            labels = payload["Config"]["Labels"]
            service = labels["com.docker.compose.service"]
            oneoff = labels.get("com.docker.compose.oneoff", "False")
            status = payload["State"]["Status"]
            health = payload["State"].get("Health", {}).get("Status", "")
        except (IndexError, KeyError, TypeError, json.JSONDecodeError):
            return False
        if oneoff.lower() == "true" or service in observed:
            return False
        observed[str(service)] = (str(status), str(health))
    return set(observed) == expected and all(
        value == ("running", "healthy") for value in observed.values()
    )


def _health(
    state: dict[str, object], *, as_json: bool, silent: bool = False
) -> None:
    _assert_resource_labels(state)
    base = f"http://127.0.0.1:{int(state['web_port'])}"
    containers_ready = _core_containers_ready(state)
    checks = {
        "containers": containers_ready,
        "database_catalog": _catalog_ready(state) if containers_ready else False,
        "api_liveness": _http_status(base + "/api/healthz"),
        "api_readiness": _api_readiness_ready(base + "/api/readyz"),
        "oidc_discovery": _http_status(
            base + "/realms/anhuan/.well-known/openid-configuration"
        ),
        "web": _http_status(base + "/"),
    }
    healthy = all(checks.values())
    payload = {
        "schema": "anhuan-local-health-v1",
        "status": "ready" if healthy else "unavailable",
        "checks": checks,
    }
    if not silent:
        if as_json:
            print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
        elif healthy:
            print(f"LOCAL_READY {base}")
        else:
            print("LOCAL_HEALTH_RED", file=sys.stderr)
    if not healthy:
        raise LocalError("LOCAL_HEALTH_RED")


def _service_container_payload(
    state: dict[str, object], service: str, *, require_healthy: bool
) -> tuple[str, dict[str, object]]:
    if service not in {"clamd", "minio", "redis"}:
        raise LocalError("LOCAL_REVERSE_SERVICE_INVALID")
    result = _compose(state, "ps", "-a", "-q", service, capture=True)
    container_ids = result.stdout.splitlines()
    if len(container_ids) != 1 or not re.fullmatch(
        r"[0-9a-f]{64}", container_ids[0]
    ):
        raise LocalError("LOCAL_REVERSE_CONTAINER_IDENTITY_INVALID")
    container_id = container_ids[0]
    inspected = _run([_docker(), "inspect", container_id], capture=True)
    try:
        payload = json.loads(inspected.stdout)[0]
        labels = payload["Config"]["Labels"]
        status = payload["State"]["Status"]
        health = payload["State"].get("Health", {}).get("Status", "")
    except (IndexError, KeyError, TypeError, json.JSONDecodeError):
        raise LocalError("LOCAL_REVERSE_CONTAINER_IDENTITY_INVALID") from None
    if (
        labels.get("com.docker.compose.project")
        != str(state["compose_project"])
        or labels.get("com.docker.compose.service") != service
        or str(labels.get("com.docker.compose.oneoff", "False")).lower()
        == "true"
        or labels.get("io.anhuan.scope") != SCOPE
        or labels.get("io.anhuan.project-id") != str(state["project_id"])
        or (
            require_healthy
            and (status != "running" or health != "healthy")
        )
    ):
        raise LocalError("LOCAL_REVERSE_CONTAINER_IDENTITY_INVALID")
    return container_id, payload


def _write_reverse_journal(payload: dict[str, object]) -> None:
    if REVERSE_JOURNAL.exists():
        raise LocalError("LOCAL_REVERSE_RECOVERY_PENDING")
    body = json.dumps(
        {"schema": REVERSE_JOURNAL_SCHEMA, **payload},
        sort_keys=True,
        separators=(",", ":"),
    ).encode("ascii")
    _exclusive_write(REVERSE_JOURNAL, body)


def _read_reverse_journal(state: dict[str, object]) -> dict[str, object] | None:
    if not REVERSE_JOURNAL.exists():
        return None
    _secure_file(REVERSE_JOURNAL, maximum=4096)
    try:
        payload = json.loads(REVERSE_JOURNAL.read_text(encoding="ascii"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        raise LocalError("LOCAL_REVERSE_RECOVERY_INVALID") from None
    common = {
        "schema",
        "kind",
        "project_id",
        "compose_project",
    }
    if (
        not isinstance(payload, dict)
        or payload.get("schema") != REVERSE_JOURNAL_SCHEMA
        or payload.get("project_id") != state["project_id"]
        or payload.get("compose_project") != state["compose_project"]
    ):
        raise LocalError("LOCAL_REVERSE_RECOVERY_INVALID")
    kind = payload.get("kind")
    if kind == "dependency":
        expected = common | {"service", "container_id"}
        if (
            set(payload) != expected
            or payload.get("service") not in {"minio", "clamd"}
            or not re.fullmatch(r"[0-9a-f]{64}", str(payload.get("container_id")))
        ):
            raise LocalError("LOCAL_REVERSE_RECOVERY_INVALID")
    elif kind == "sentinel":
        expected = common | {
            "nonce",
            "container_name",
            "volume_name",
            "image_id",
        }
        nonce = str(payload.get("nonce"))
        if (
            set(payload) != expected
            or not re.fullmatch(r"[0-9a-f]{24}", nonce)
            or payload.get("container_name")
            != f"anhuan-foreign-sentinel-{nonce}"
            or payload.get("volume_name")
            != f"anhuan-foreign-sentinel-{nonce}"
            or not re.fullmatch(r"sha256:[0-9a-f]{64}", str(payload.get("image_id")))
        ):
            raise LocalError("LOCAL_REVERSE_RECOVERY_INVALID")
    else:
        raise LocalError("LOCAL_REVERSE_RECOVERY_INVALID")
    return payload


def _remove_reverse_journal() -> None:
    _secure_file(REVERSE_JOURNAL, maximum=4096)
    try:
        REVERSE_JOURNAL.unlink()
    except OSError:
        raise LocalError("LOCAL_REVERSE_RECOVERY_CLEANUP_FAILED") from None
    if REVERSE_JOURNAL.exists():
        raise LocalError("LOCAL_REVERSE_RECOVERY_CLEANUP_FAILED")


def _wait_dependency_recovered(
    state: dict[str, object], service: str, container_id: str
) -> None:
    deadline = time.monotonic() + 360
    while time.monotonic() < deadline:
        try:
            observed_id, _payload = _service_container_payload(
                state, service, require_healthy=True
            )
        except LocalError:
            time.sleep(1)
            continue
        if observed_id == container_id:
            base = f"http://127.0.0.1:{int(state['web_port'])}"
            if _api_readiness_ready(base + "/api/readyz"):
                return
        time.sleep(1)
    raise LocalError("LOCAL_REVERSE_DEPENDENCY_RECOVERY_FAILED")


def _probe_dependency_outage(
    state: dict[str, object], service: str
) -> dict[str, int]:
    container_id, _payload = _service_container_payload(
        state, service, require_healthy=True
    )
    base = f"http://127.0.0.1:{int(state['web_port'])}"
    primary: LocalError | None = None
    recovered = False
    health_red = False
    component_red = False
    _write_reverse_journal(
        {
            "kind": "dependency",
            "project_id": state["project_id"],
            "compose_project": state["compose_project"],
            "service": service,
            "container_id": container_id,
        }
    )
    try:
        _run(
            [_docker(), "stop", "--time", "30", container_id],
            capture=True,
            timeout=45,
        )
        try:
            _health(state, as_json=False, silent=True)
        except LocalError as error:
            if str(error) != "LOCAL_HEALTH_RED":
                raise
            health_red = True
        observation = _api_readiness_observation(
            base + "/api/readyz", timeout_seconds=15
        )
        if observation is not None:
            status_code, payload = observation
            components = payload.get("components")
            if isinstance(components, dict):
                component_red = bool(
                    status_code == 503
                    and components.get(service) is False
                    and all(
                        value is True
                        for name, value in components.items()
                        if name != service
                    )
                )
        if not health_red or not component_red or _core_containers_ready(state):
            raise LocalError("LOCAL_REVERSE_DEPENDENCY_HEALTH_FAILED")
    except LocalError as error:
        primary = error
    finally:
        try:
            _recover_reverse_journal(state)
            recovered = True
        except LocalError:
            recovered = False
    if not recovered:
        raise LocalError("LOCAL_REVERSE_DEPENDENCY_RECOVERY_FAILED")
    if primary is not None:
        raise primary
    return {f"{service}_health_red_count": 1, f"{service}_recovery_count": 1}


def _synthetic_secret_permission_probe() -> int:
    _directory(TMP_DIR)
    nonce = secrets.token_hex(12)
    probe = TMP_DIR / f"reverse-secrets-{nonce}"
    probe.mkdir(mode=0o700)
    _directory(probe)
    rejected = 0
    try:
        for name in ALL_SECRET_NAMES:
            size = 32 if name == "f0i_key" else 16
            _exclusive_write(probe / name, secrets.token_bytes(size))
        target = probe / "f1_qa_key"
        os.chmod(target, 0o644)
        try:
            _validate_secret_set(probe)
        except LocalError as error:
            if str(error) != "LOCAL_FILE_PERMISSIONS_INVALID":
                raise
            rejected = 1
        else:
            raise LocalError("LOCAL_REVERSE_SECRET_REJECTION_FAILED")
    finally:
        cleanup_failed = False
        try:
            target = probe / "f1_qa_key"
            if target.exists():
                os.chmod(target, 0o600)
            entries = {entry.name for entry in os.scandir(probe)}
            if entries != set(ALL_SECRET_NAMES):
                cleanup_failed = True
            for name in ALL_SECRET_NAMES:
                path = probe / name
                if path.exists():
                    _secure_file(path, minimum=16, maximum=32)
                    path.unlink()
            probe.rmdir()
        except (OSError, LocalError):
            cleanup_failed = True
        if cleanup_failed:
            raise LocalError("LOCAL_REVERSE_SECRET_CLEANUP_FAILED")
    return rejected


def _dependency_verify(state: dict[str, object]) -> None:
    _health(state, as_json=False, silent=True)
    secret_rejected = _synthetic_secret_permission_probe()
    _health(state, as_json=False, silent=True)
    minio = _probe_dependency_outage(state, "minio")
    clamd = _probe_dependency_outage(state, "clamd")
    _health(state, as_json=False, silent=True)
    metrics = {
        "clamd_health_red_count": clamd["clamd_health_red_count"],
        "clamd_recovery_count": clamd["clamd_recovery_count"],
        "dependency_false_ready_count": 0,
        "minio_health_red_count": minio["minio_health_red_count"],
        "minio_recovery_count": minio["minio_recovery_count"],
        "secret_0644_rejection_count": secret_rejected,
        "secret_recovery_ready_count": 1,
    }
    print(json.dumps(metrics, sort_keys=True, separators=(",", ":")))
    print("LOCAL_DEPENDENCY_BOUNDARIES_OK")


def _reset(state: dict[str, object], *, confirmed: bool) -> None:
    if not confirmed:
        raise LocalError("LOCAL_RESET_CONFIRMATION_REQUIRED")
    _assert_resource_labels(state)
    _compose(
        state,
        "down",
        "--volumes",
        "--remove-orphans",
        "--timeout",
        "30",
        timeout=180,
    )
    # Compose only knows volumes declared by the current file.  If a previous
    # local schema used another project-owned volume name, remove that exact
    # double-labelled residual explicitly rather than using a name glob or a
    # daemon-wide prune.
    _assert_resource_labels(state)
    for container_id in _resource_ids("ps", str(state["compose_project"])):
        _run([_docker(), "rm", "-f", container_id])
    for volume_id in _resource_ids("volume", str(state["compose_project"])):
        _run([_docker(), "volume", "rm", volume_id])
    for network_id in _resource_ids("network", str(state["compose_project"])):
        _run([_docker(), "network", "rm", network_id])
    if any(
        _resource_ids(kind, str(state["compose_project"]))
        for kind in ("ps", "volume", "network")
    ):
        raise LocalError("LOCAL_RESET_RESIDUALS")
    print("LOCAL_RESET_OK")


def _inspect_foreign_sentinel(
    container_id: str,
    volume_name: str,
    nonce: str,
    image_id: str,
) -> bool:
    container = _run(
        [_docker(), "inspect", container_id], capture=True, check=False
    )
    volume = _run(
        [_docker(), "volume", "inspect", volume_name],
        capture=True,
        check=False,
    )
    if container.returncode != 0 or volume.returncode != 0:
        return False
    try:
        container_payload = json.loads(container.stdout)[0]
        volume_payload = json.loads(volume.stdout)[0]
        labels = container_payload["Config"]["Labels"]
        volume_labels = volume_payload["Labels"]
        mounts = container_payload["Mounts"]
    except (IndexError, KeyError, TypeError, json.JSONDecodeError):
        return False
    return bool(
        container_payload.get("Image") == image_id
        and labels
        == {
            "io.anhuan.reverse-sentinel": nonce,
            "io.anhuan.scope": "foreign-sentinel",
        }
        and volume_labels
        == {
            "io.anhuan.reverse-sentinel": nonce,
            "io.anhuan.scope": "foreign-sentinel",
        }
        and len(mounts) == 1
        and mounts[0].get("Type") == "volume"
        and mounts[0].get("Name") == volume_name
        and mounts[0].get("Destination") == "/sentinel"
    )


def _sentinel_label_residuals(nonce: str) -> tuple[list[str], list[str]]:
    container_result = _run(
        [
            _docker(),
            "ps",
            "-a",
            "-q",
            "--filter",
            f"label=io.anhuan.reverse-sentinel={nonce}",
        ],
        capture=True,
    )
    volume_result = _run(
        [
            _docker(),
            "volume",
            "ls",
            "-q",
            "--filter",
            f"label=io.anhuan.reverse-sentinel={nonce}",
        ],
        capture=True,
    )
    containers = [entry for entry in container_result.stdout.splitlines() if entry]
    volumes = [entry for entry in volume_result.stdout.splitlines() if entry]
    if any(not re.fullmatch(r"[0-9a-f]{64}", entry) for entry in containers):
        raise LocalError("LOCAL_REVERSE_SENTINEL_CLEANUP_FAILED")
    return containers, volumes


def _recover_reverse_journal(state: dict[str, object]) -> None:
    payload = _read_reverse_journal(state)
    if payload is None:
        return
    if payload["kind"] == "dependency":
        service = str(payload["service"])
        expected_id = str(payload["container_id"])
        observed_id, _container = _service_container_payload(
            state, service, require_healthy=False
        )
        if observed_id != expected_id:
            raise LocalError("LOCAL_REVERSE_RECOVERY_IDENTITY_MISMATCH")
        _run([_docker(), "start", expected_id], capture=True, timeout=45)
        _wait_dependency_recovered(state, service, expected_id)
        _remove_reverse_journal()
        return

    nonce = str(payload["nonce"])
    container_name = str(payload["container_name"])
    volume_name = str(payload["volume_name"])
    image_id = str(payload["image_id"])
    cleanup_failed = False
    container_id: str | None = None
    inspected = _run(
        [_docker(), "inspect", container_name], capture=True, check=False
    )
    if inspected.returncode == 0:
        try:
            candidate = json.loads(inspected.stdout)[0]
            candidate_id = candidate["Id"]
        except (IndexError, KeyError, TypeError, json.JSONDecodeError):
            raise LocalError("LOCAL_REVERSE_RECOVERY_INVALID") from None
        if (
            not re.fullmatch(r"[0-9a-f]{64}", str(candidate_id))
            or not _inspect_foreign_sentinel(
                str(candidate_id), volume_name, nonce, image_id
            )
        ):
            raise LocalError("LOCAL_REVERSE_RECOVERY_IDENTITY_MISMATCH")
        container_id = str(candidate_id)
    if container_id is not None:
        removed = _run(
            [_docker(), "rm", "-f", container_id], capture=True, check=False
        )
        cleanup_failed = cleanup_failed or removed.returncode != 0

    volume = _run(
        [_docker(), "volume", "inspect", volume_name],
        capture=True,
        check=False,
    )
    if volume.returncode == 0:
        try:
            labels = json.loads(volume.stdout)[0]["Labels"]
        except (IndexError, KeyError, TypeError, json.JSONDecodeError):
            raise LocalError("LOCAL_REVERSE_RECOVERY_INVALID") from None
        if labels != {
            "io.anhuan.reverse-sentinel": nonce,
            "io.anhuan.scope": "foreign-sentinel",
        }:
            raise LocalError("LOCAL_REVERSE_RECOVERY_IDENTITY_MISMATCH")
        removed = _run(
            [_docker(), "volume", "rm", volume_name],
            capture=True,
            check=False,
        )
        cleanup_failed = cleanup_failed or removed.returncode != 0

    containers, volumes = _sentinel_label_residuals(nonce)
    if cleanup_failed or containers or volumes:
        raise LocalError("LOCAL_REVERSE_SENTINEL_CLEANUP_FAILED")
    _remove_reverse_journal()


def _reset_with_foreign_sentinel(
    state: dict[str, object], *, confirmed: bool
) -> None:
    if not confirmed:
        raise LocalError("LOCAL_RESET_CONFIRMATION_REQUIRED")
    _assert_resource_labels(state)
    inspected_image = _run(
        [_docker(), "image", "inspect", REVERSE_SENTINEL_IMAGE], capture=True
    )
    try:
        image_payload = json.loads(inspected_image.stdout)[0]
        image_id = image_payload["Id"]
        image_digests = image_payload["RepoDigests"]
        image_labels = image_payload["Config"].get("Labels")
        declared_volumes = image_payload["Config"].get("Volumes")
    except (IndexError, KeyError, TypeError, json.JSONDecodeError):
        raise LocalError("LOCAL_REVERSE_SENTINEL_IMAGE_INVALID") from None
    if (
        image_id != REVERSE_SENTINEL_IMAGE_ID
        or not isinstance(image_digests, list)
        or REVERSE_SENTINEL_IMAGE.replace("python:3.11-slim@", "python@")
        not in image_digests
        or image_labels not in (None, {})
        or declared_volumes not in (None, {})
    ):
        raise LocalError("LOCAL_REVERSE_SENTINEL_IMAGE_INVALID")
    nonce = secrets.token_hex(12)
    volume_name = f"anhuan-foreign-sentinel-{nonce}"
    container_name = f"anhuan-foreign-sentinel-{nonce}"
    container_id: str | None = None
    primary: LocalError | None = None
    survived = False
    _write_reverse_journal(
        {
            "kind": "sentinel",
            "project_id": state["project_id"],
            "compose_project": state["compose_project"],
            "nonce": nonce,
            "container_name": container_name,
            "volume_name": volume_name,
            "image_id": image_id,
        }
    )
    try:
        if (
            _run(
                [_docker(), "inspect", container_name],
                capture=True,
                check=False,
            ).returncode
            == 0
            or _run(
                [_docker(), "volume", "inspect", volume_name],
                capture=True,
                check=False,
            ).returncode
            == 0
        ):
            raise LocalError("LOCAL_REVERSE_SENTINEL_COLLISION")
        volume = _run(
            [
                _docker(),
                "volume",
                "create",
                "--label",
                f"io.anhuan.reverse-sentinel={nonce}",
                "--label",
                "io.anhuan.scope=foreign-sentinel",
                volume_name,
            ],
            capture=True,
        )
        if volume.stdout.strip() != volume_name:
            raise LocalError("LOCAL_REVERSE_SENTINEL_CREATE_FAILED")
        created = _run(
            [
                _docker(),
                "create",
                "--name",
                container_name,
                "--label",
                f"io.anhuan.reverse-sentinel={nonce}",
                "--label",
                "io.anhuan.scope=foreign-sentinel",
                "--mount",
                f"type=volume,src={volume_name},dst=/sentinel",
                image_id,
                "sh",
                "-c",
                "exit 0",
            ],
            capture=True,
        )
        candidate = created.stdout.strip()
        if not re.fullmatch(r"[0-9a-f]{64}", candidate):
            raise LocalError("LOCAL_REVERSE_SENTINEL_CREATE_FAILED")
        container_id = candidate
        if not _inspect_foreign_sentinel(
            container_id, volume_name, nonce, image_id
        ):
            raise LocalError("LOCAL_REVERSE_SENTINEL_IDENTITY_INVALID")
        _reset(state, confirmed=True)
        survived = _inspect_foreign_sentinel(
            container_id, volume_name, nonce, image_id
        )
        if not survived:
            raise LocalError("LOCAL_REVERSE_SENTINEL_SURVIVAL_FAILED")
    except LocalError as error:
        primary = error
    finally:
        try:
            _recover_reverse_journal(state)
        except LocalError:
            raise LocalError("LOCAL_REVERSE_SENTINEL_CLEANUP_FAILED") from None
    if primary is not None:
        raise primary
    metrics = {
        "foreign_cleanup_residual_count": 0,
        "foreign_container_survival_count": int(survived),
        "foreign_volume_survival_count": int(survived),
    }
    print(json.dumps(metrics, sort_keys=True, separators=(",", ":")))
    print("LOCAL_FOREIGN_SENTINEL_OK")


def _stop(state: dict[str, object]) -> None:
    _assert_resource_labels(state)
    _compose(state, "stop", "--timeout", "30", timeout=120)
    project = str(state["compose_project"])
    # A service removed from a newer Compose file is an orphan.  It still
    # belongs to this exact project, so stop it by its validated container ID
    # and never by prefix, wildcard, or daemon-wide operation.
    for container_id in _resource_ids("ps", project):
        result = _run([_docker(), "inspect", container_id], capture=True)
        try:
            running = bool(json.loads(result.stdout)[0]["State"]["Running"])
        except (IndexError, KeyError, TypeError, json.JSONDecodeError):
            raise LocalError("LOCAL_RESOURCE_IDENTITY_INVALID") from None
        if running:
            _run(
                [_docker(), "stop", "--time", "30", container_id],
                capture=True,
                timeout=45,
            )
    for container_id in _resource_ids("ps", project):
        result = _run([_docker(), "inspect", container_id], capture=True)
        try:
            if bool(json.loads(result.stdout)[0]["State"]["Running"]):
                raise LocalError("LOCAL_STOP_RESIDUALS")
        except (IndexError, KeyError, TypeError, json.JSONDecodeError):
            raise LocalError("LOCAL_RESOURCE_IDENTITY_INVALID") from None
    print("LOCAL_STOPPED")


def _new_backup_id() -> str:
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return f"{timestamp}-{secrets.token_hex(6)}"


def _business_snapshot(state: dict[str, object]) -> dict[str, object]:
    selects = [
        f"SELECT '{name}',count(*)::bigint FROM f1.\"{name}\""
        for name in P2_P7_TABLES
    ]
    result = _compose(
        state,
        "exec",
        "-T",
        "postgres",
        "psql",
        "--no-psqlrc",
        "--tuples-only",
        "--no-align",
        "--field-separator=|",
        "--set",
        "ON_ERROR_STOP=1",
        "--username=f0d_bootstrap",
        "--dbname",
        str(state["database"]),
        "--command",
        " UNION ALL ".join(selects) + " ORDER BY 1",
        capture=True,
        timeout=60,
    )
    counts: dict[str, int] = {}
    for line in result.stdout.splitlines():
        match = re.fullmatch(r"([a-z][a-z0-9_]{0,63})\|([0-9]{1,20})", line)
        if match is None or match.group(1) in counts:
            raise LocalError("LOCAL_BUSINESS_SNAPSHOT_INVALID")
        value = int(match.group(2))
        if value > 2**63 - 1:
            raise LocalError("LOCAL_BUSINESS_SNAPSHOT_INVALID")
        counts[match.group(1)] = value
    if set(counts) != set(P2_P7_TABLES):
        raise LocalError("LOCAL_BUSINESS_SNAPSHOT_INVALID")
    digest = hashlib.sha256(b"ANHUAN_BUSINESS_COUNTS_V1\x00")
    for name in sorted(counts):
        encoded = name.encode("ascii")
        digest.update(len(encoded).to_bytes(2, "big"))
        digest.update(encoded)
        digest.update(counts[name].to_bytes(8, "big"))
    return {
        "table_count": len(counts),
        "total_row_count": sum(counts.values()),
        "nonempty_table_count": sum(value > 0 for value in counts.values()),
        "count_sha256": digest.hexdigest(),
    }


def _manifest_business_snapshot(manifest: dict[str, object]) -> dict[str, object]:
    return {
        "table_count": manifest["business_table_count"],
        "total_row_count": manifest["business_total_row_count"],
        "nonempty_table_count": manifest["business_nonempty_table_count"],
        "count_sha256": manifest["business_count_sha256"],
    }


def _backup_catalog() -> dict[str, Path]:
    _directory(BACKUPS_DIR)
    backups: dict[str, Path] = {}
    try:
        entries = list(os.scandir(BACKUPS_DIR))
    except OSError:
        raise LocalError("LOCAL_BACKUP_CATALOG_INVALID") from None
    for entry in entries:
        path = Path(entry.path)
        try:
            info = path.lstat()
        except OSError:
            raise LocalError("LOCAL_BACKUP_CATALOG_INVALID") from None
        if (
            stat.S_ISLNK(info.st_mode)
            or not stat.S_ISDIR(info.st_mode)
            or stat.S_IMODE(info.st_mode) != 0o700
            or info.st_uid != os.geteuid()
        ):
            raise LocalError("LOCAL_BACKUP_CATALOG_INVALID")
        if BACKUP_ID_RE.fullmatch(entry.name):
            backups[entry.name] = path
        elif not PENDING_BACKUP_RE.fullmatch(entry.name):
            raise LocalError("LOCAL_BACKUP_CATALOG_INVALID")
    return backups


def _resolve_backup(backup_id: str | None) -> tuple[str, Path]:
    if backup_id is not None and not BACKUP_ID_RE.fullmatch(backup_id):
        raise LocalError("LOCAL_BACKUP_ID_INVALID")
    backups = _backup_catalog()
    selected = backup_id if backup_id is not None else max(backups, default=None)
    if selected is None or selected not in backups:
        raise LocalError("LOCAL_BACKUP_NOT_FOUND")
    return selected, backups[selected]


def _remove_pending_backup(path: Path) -> None:
    if (
        path.parent != BACKUPS_DIR
        or not PENDING_BACKUP_RE.fullmatch(path.name)
    ):
        raise LocalError("LOCAL_BACKUP_STAGING_INVALID")
    try:
        info = path.lstat()
    except FileNotFoundError:
        return
    except OSError:
        raise LocalError("LOCAL_BACKUP_STAGING_INVALID") from None
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISDIR(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o700
        or info.st_uid != os.geteuid()
    ):
        raise LocalError("LOCAL_BACKUP_STAGING_INVALID")
    try:
        shutil.rmtree(path)
    except OSError:
        raise LocalError("LOCAL_BACKUP_STAGING_CLEANUP_FAILED") from None


def _resume_after_backup(state: dict[str, object]) -> None:
    _compose(
        state,
        "up",
        "-d",
        "--wait",
        "--wait-timeout",
        "180",
        "minio",
        "api",
        "worker",
        "dispatcher",
        "web",
        capture=True,
        timeout=240,
    )
    if not _core_containers_ready(state):
        raise LocalError("LOCAL_BACKUP_RESUME_FAILED")


def _backup(state: dict[str, object]) -> None:
    _directory(BACKUPS_DIR)
    if not _core_containers_ready(state):
        raise LocalError("LOCAL_BACKUP_SOURCE_UNAVAILABLE")
    _assert_resource_labels(state)
    _sync_secrets(state, capture=True)
    backup_id = _new_backup_id()
    if not BACKUP_ID_RE.fullmatch(backup_id):
        raise LocalError("LOCAL_BACKUP_ID_INVALID")
    final = BACKUPS_DIR / backup_id
    pending = BACKUPS_DIR / f".pending-{backup_id}"
    if final.exists() or pending.exists() or pending.is_symlink():
        raise LocalError("LOCAL_BACKUP_ID_COLLISION")
    try:
        pending.mkdir(mode=0o700)
        pending.chmod(0o700)
    except OSError:
        raise LocalError("LOCAL_BACKUP_STAGING_FAILED") from None

    failure: LocalError | None = None
    stopped = False
    try:
        stopped = True
        _compose(
            state,
            "stop",
            "--timeout",
            "30",
            "web",
            "api",
            "worker",
            "dispatcher",
            "minio",
            capture=True,
            timeout=120,
        )
        # Writers are quiesced before both the row-count commitment and dump,
        # so the manifest cannot describe a different database moment.
        business_snapshot = _business_snapshot(state)
        stage_mount = f"{pending}:/backup"
        _compose(
            state,
            "run",
            "--rm",
            "--no-deps",
            "--volume",
            stage_mount,
            "backup-db",
            capture=True,
            timeout=600,
        )
        _compose(
            state,
            "run",
            "--rm",
            "--no-deps",
            "--volume",
            stage_mount,
            "backup-minio",
            capture=True,
            timeout=600,
        )
        local_backup.create_manifest(
            pending,
            str(state["project_id"]),
            str(state["database"]),
            business_snapshot,
        )
        local_backup.verify_backup(
            pending, str(state["project_id"]), str(state["database"])
        )
    except local_backup.BackupContractError:
        failure = LocalError("LOCAL_BACKUP_MANIFEST_INVALID")
    except LocalError as error:
        failure = error
    except OSError:
        failure = LocalError("LOCAL_BACKUP_STAGING_FAILED")
    finally:
        if stopped:
            try:
                _resume_after_backup(state)
            except LocalError:
                failure = LocalError("LOCAL_BACKUP_RESUME_FAILED")

    if failure is not None:
        _remove_pending_backup(pending)
        raise failure
    try:
        pending.rename(final)
    except OSError:
        _remove_pending_backup(pending)
        raise LocalError("LOCAL_BACKUP_FINALIZE_FAILED") from None
    print(f"LOCAL_BACKUP_OK {backup_id}")


def _project_data_volumes(state: dict[str, object]) -> dict[str, str]:
    _assert_resource_labels(state)
    result: dict[str, str] = {}
    for volume_id in _resource_ids("volume", str(state["compose_project"])):
        inspected = _run(
            [_docker(), "volume", "inspect", volume_id], capture=True
        )
        try:
            labels = json.loads(inspected.stdout)[0]["Labels"]
            logical_name = labels.get("com.docker.compose.volume")
        except (IndexError, KeyError, TypeError, json.JSONDecodeError):
            raise LocalError("LOCAL_RESOURCE_IDENTITY_INVALID") from None
        if logical_name in DATA_VOLUME_KEYS:
            if logical_name in result:
                raise LocalError("LOCAL_DATA_VOLUME_IDENTITY_INVALID")
            result[str(logical_name)] = volume_id
    return result


def _cleanup_failed_restore(state: dict[str, object]) -> None:
    # Compose may have failed after creating only one of the two data volumes.
    # Remove every exact current-project container first so neither a partial
    # application nor a volume attachment survives the failed restore.
    compose_cleanup_completed = True
    try:
        _compose(
            state,
            "down",
            "--remove-orphans",
            "--timeout",
            "30",
            capture=True,
            timeout=180,
        )
    except LocalError:
        # The exact-ID fallback below is the authoritative cleanup result.
        compose_cleanup_completed = False
    try:
        _assert_resource_labels(state)
        project = str(state["compose_project"])
        container_ids = _resource_ids("ps", project)
        if not compose_cleanup_completed and not container_ids:
            # Compose reported a failure, but the final exact resource state
            # already proves there is no partial application to remove.
            compose_cleanup_completed = True
        for container_id in container_ids:
            _run(
                [_docker(), "rm", "-f", container_id],
                capture=True,
                timeout=60,
            )
        _assert_resource_labels(state)
        for volume_id in _project_data_volumes(state).values():
            _run([_docker(), "volume", "rm", volume_id], capture=True)
        if _resource_ids("ps", project) or _project_data_volumes(state):
            raise LocalError("LOCAL_RESTORE_CLEANUP_FAILED")
        if not compose_cleanup_completed and container_ids:
            # The exact-ID fallback above completed the cleanup.
            compose_cleanup_completed = True
        if not compose_cleanup_completed:
            raise LocalError("LOCAL_RESTORE_CLEANUP_FAILED")
    except LocalError:
        raise LocalError("LOCAL_RESTORE_CLEANUP_FAILED") from None


def _new_restore_check_directory() -> Path:
    path = TMP_DIR / f"restore-check-{secrets.token_hex(12)}"
    if path.exists() or path.is_symlink():
        raise LocalError("LOCAL_RESTORE_CHECK_COLLISION")
    try:
        path.mkdir(mode=0o700)
    except OSError:
        raise LocalError("LOCAL_RESTORE_CHECK_INVALID") from None
    _directory(path)
    return path


def _remove_restore_check_directory(path: Path) -> None:
    if path.parent != TMP_DIR or not re.fullmatch(
        r"restore-check-[0-9a-f]{24}", path.name
    ):
        raise LocalError("LOCAL_RESTORE_CHECK_INVALID")
    try:
        _directory(path)
        shutil.rmtree(path)
    except (OSError, LocalError):
        raise LocalError("LOCAL_RESTORE_CHECK_CLEANUP_FAILED") from None


def _restore(
    state: dict[str, object], *, backup_id: str | None, confirmed: bool
) -> None:
    if not confirmed:
        raise LocalError("LOCAL_RESTORE_CONFIRMATION_REQUIRED")
    selected_id, backup = _resolve_backup(backup_id)
    try:
        manifest = local_backup.verify_backup(
            backup, str(state["project_id"]), str(state["database"])
        )
    except local_backup.BackupContractError:
        raise LocalError("LOCAL_BACKUP_MANIFEST_INVALID") from None

    destructive_started = False
    try:
        data_volumes = _project_data_volumes(state)
        _compose(
            state,
            "down",
            "--remove-orphans",
            "--timeout",
            "30",
            capture=True,
            timeout=180,
        )
        _assert_resource_labels(state)
        destructive_started = True
        for logical_name in sorted(data_volumes):
            _run(
                [_docker(), "volume", "rm", data_volumes[logical_name]],
                capture=True,
            )
        if _project_data_volumes(state):
            raise LocalError("LOCAL_RESTORE_DATA_VOLUME_RESIDUAL")

        _sync_secrets(state, capture=True)
        _compose(
            state,
            "up",
            "-d",
            "--wait",
            "--wait-timeout",
            "180",
            "postgres",
            capture=True,
            timeout=240,
        )
        # The dump keeps the exact owners of the F1 definer functions.  A
        # fresh PostgreSQL volume has only the F0 bootstrap roles, so create
        # all protected roles before pg_restore replaces database objects.
        _compose(
            state,
            "run",
            "--rm",
            "migrator",
            capture=True,
            timeout=600,
        )
        backup_mount = f"{backup}:/backup:ro"
        _compose(
            state,
            "run",
            "--rm",
            "--no-deps",
            "--volume",
            backup_mount,
            "restore-db",
            capture=True,
            timeout=600,
        )
        _compose(
            state,
            "run",
            "--rm",
            "--no-deps",
            "--volume",
            backup_mount,
            "restore-minio",
            capture=True,
            timeout=600,
        )
        restore_check = _new_restore_check_directory()
        try:
            _compose(
                state,
                "run",
                "--rm",
                "--no-deps",
                "--volume",
                f"{restore_check}:/backup",
                "backup-minio",
                capture=True,
                timeout=600,
            )
            minio_summary = local_backup.verify_restored_minio(
                backup, restore_check / local_backup.MINIO_DIRECTORY_NAME
            )
            expected_minio = {
                "minio_tree_sha256": manifest["minio_tree_sha256"],
                "minio_file_count": manifest["minio_file_count"],
                "minio_total_size": manifest["minio_total_size"],
            }
            if minio_summary != expected_minio:
                raise LocalError("LOCAL_RESTORE_MINIO_IDENTITY_MISMATCH")
        finally:
            _remove_restore_check_directory(restore_check)
        if set(_project_data_volumes(state)) != DATA_VOLUME_KEYS:
            raise LocalError("LOCAL_RESTORE_DATA_VOLUME_INCOMPLETE")
        _start(state, capture=True, announce=False)
        if _business_snapshot(state) != _manifest_business_snapshot(manifest):
            raise LocalError("LOCAL_RESTORE_BUSINESS_IDENTITY_MISMATCH")
    except local_backup.BackupContractError:
        if destructive_started:
            _cleanup_failed_restore(state)
        raise LocalError("LOCAL_RESTORE_IDENTITY_MISMATCH") from None
    except LocalError:
        if destructive_started:
            _cleanup_failed_restore(state)
        raise
    print(f"LOCAL_RESTORE_OK {selected_id}")


@contextlib.contextmanager
def _lock() -> object:
    _directory(STATE_DIR)
    descriptor = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        os.close(descriptor)
        raise LocalError("LOCAL_COMMAND_ALREADY_RUNNING") from None
    try:
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="localctl")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("start")
    subparsers.add_parser("test")
    subparsers.add_parser("stop")
    health = subparsers.add_parser("health")
    health.add_argument("--json", action="store_true")
    subparsers.add_parser("dependency-verify")
    subparsers.add_parser("migrate")
    subparsers.add_parser("seed")
    reset = subparsers.add_parser("reset")
    reset.add_argument("--confirm-local-data", action="store_true")
    reset.add_argument("--prove-foreign-sentinel", action="store_true")
    subparsers.add_parser("backup")
    restore = subparsers.add_parser("restore")
    restore.add_argument("--backup-id")
    restore.add_argument("--confirm-local-data", action="store_true")
    subparsers.add_parser("verify")
    browser_verify = subparsers.add_parser("browser-verify")
    browser_verify.add_argument(
        "--stage",
        choices=sorted(BROWSER_STAGES),
        default="all",
    )
    return parser


def main() -> int:
    arguments = _parser().parse_args()
    try:
        if arguments.command in {
            "stop",
            "health",
            "dependency-verify",
            "reset",
            "backup",
            "restore",
            "verify",
            "browser-verify",
        }:
            if not STATE_FILE.exists():
                raise LocalError("LOCAL_NOT_INITIALIZED")
            _directory(STATE_DIR)
            state = _read_state()
            if arguments.command not in {"stop", "reset"}:
                _validate_existing_layout()
            _write_docker_config()
            _write_compose_env(state)
        else:
            state = _initialize()
        with _lock():
            _recover_browser_recovery_journal(state)
            _recover_reverse_journal(state)
            if arguments.command == "start":
                _start(state)
            elif arguments.command == "test":
                _targeted_test(state)
            elif arguments.command == "stop":
                _stop(state)
            elif arguments.command == "health":
                _health(state, as_json=bool(arguments.json))
            elif arguments.command == "dependency-verify":
                _dependency_verify(state)
            elif arguments.command == "migrate":
                _migrate(state)
                print("LOCAL_MIGRATE_OK")
            elif arguments.command == "seed":
                _seed(state)
                print("LOCAL_SEED_OK")
            elif arguments.command == "reset":
                if bool(arguments.prove_foreign_sentinel):
                    _reset_with_foreign_sentinel(
                        state, confirmed=bool(arguments.confirm_local_data)
                    )
                else:
                    _reset(state, confirmed=bool(arguments.confirm_local_data))
            elif arguments.command == "backup":
                _backup(state)
            elif arguments.command == "restore":
                _restore(
                    state,
                    backup_id=arguments.backup_id,
                    confirmed=bool(arguments.confirm_local_data),
                )
            elif arguments.command == "verify":
                _verify(state)
            elif arguments.command == "browser-verify":
                _browser_verify(state, stage=arguments.stage)
            else:
                raise LocalError("LOCAL_COMMAND_PENDING")
        return 0
    except LocalError as error:
        print(str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
